# ==================================================
# LARGE TEXT FUNCTIONS
# ==================================================

def big_text(display_object, text, x, y, scale):
    width = len(text) * 8
    height = 8

    buffer = bytearray(width * height)

    text_buffer = framebuf.FrameBuffer(
        buffer,
        width,
        height,
        framebuf.MONO_VLSB
    )

    text_buffer.text(text, 0, 0, 1)

    for pixel_x in range(width):
        for pixel_y in range(height):
            if text_buffer.pixel(pixel_x, pixel_y):
                display_object.fill_rect(
                    x + pixel_x * scale,
                    y + pixel_y * scale,
                    scale,
                    scale,
                    1
                )


def big_text_stretched(
    display_object,
    text,
    x,
    y,
    scale_x,
    scale_y
):
    width = len(text) * 8
    height = 8

    buffer = bytearray(width * height)

    text_buffer = framebuf.FrameBuffer(
        buffer,
        width,
        height,
        framebuf.MONO_VLSB
    )

    text_buffer.text(text, 0, 0, 1)

    for pixel_x in range(width):
        for pixel_y in range(height):
            if text_buffer.pixel(pixel_x, pixel_y):
                display_object.fill_rect(
                    x + pixel_x * scale_x,
                    y + pixel_y * scale_y,
                    scale_x,
                    scale_y,
                    1
                )


def draw_omega(x, y, scale):
    omega_bitmap = (
        "0011111100",
        "0110000110",
        "1100000011",
        "1100000011",
        "1100000011",
        "1100000011",
        "1100000011",
        "1100000011",
        "0110000110",
        "0011111100",
        "0010010100",
        "1100010011"
    )

    for row in range(12):
        for column in range(10):
            if omega_bitmap[row][column] == "1":
                display.fill_rect(
                    x + column * scale,
                    y + row * scale,
                    scale,
                    scale,
                    1
                )


# ==================================================
# VALUE FORMATTERS
# ==================================================

def resistance_value():
    return (
        digits[0] * 100000 +
        digits[1] * 10000 +
        digits[2] * 1000 +
        digits[3] * 100 +
        digits[4] * 10 +
        digits[5]
    )


def total_resistance_value():
    result = resistance_value()

    if extra_one_meg_enabled:
        result += 1000000

    return result


def resistance_string():
    return "{:,}".format(
        total_resistance_value()
    )

def current_string(current_amps):
    current_abs = abs(current_amps)

    # Below about 1 mA the INA238 offset error makes the
    # reading unreliable, so no microamps are shown.
    if current_abs < 0.001:
        return "<1mA"

    if current_abs < 1.0:
        return "{:.1f}mA".format(
            current_amps * 1000
        )

    return "{:.3f}A".format(current_amps)

def voltage_string(voltage_volts):
    return "{:.3f}V".format(
        voltage_volts
    )


def power_string(power_watts):
    if abs(power_watts) < 1.0:
        return "{:.1f}mW".format(
            power_watts * 1000
        )

    return "{:.3f}W".format(
        power_watts
    )


# ==================================================
# SSD1306 BRIGHTNESS CONTROL
#
# Contrast command = 0x81 followed by 0..255.
# ==================================================

def set_oled_brightness(oled, brightness):
    brightness = clamp(brightness, 0, 255)

    try:
        oled.write_cmd(0x81)
        oled.write_cmd(brightness)

    except Exception as error:
        if i2c_debug_enabled:
            print("OLED contrast error:", error)


def apply_main_oled_brightness():
    set_oled_brightness(
        display,
        main_oled_brightness
    )


def apply_aux_oled_brightness():
    if not ENABLE_ENCODER_DISPLAYS:
        return

    for channel_number in range(NUMBER_OF_ENCODERS):
        oled = small_displays[channel_number]

        if oled is None:
            continue

        if tca_select_channel(channel_number):
            set_oled_brightness(
                oled,
                aux_oled_brightness
            )

    tca_disable_all_channels()


# ==================================================
# BOOT SCREEN / POST
# ==================================================

def draw_boot_screen():
    display.fill(0)

    display.text("LAB CONTROL", 20, 10)
    display.text("PANEL", 44, 22)
    display.text("STARTING", 32, 44)

    display.show()


def post_status(enabled, ok):
    if not enabled:
        return "OFF"

    if ok:
        return "OK"

    return "FAIL"


def draw_post_screen(
    main_oled_ok,
    mcp1_ok,
    mcp2_ok,
    tca_ok
):
    display.fill(0)

    display.text("HARDWARE POST", 8, 0)

    display.text(
        "MAIN OLED " + post_status(True, main_oled_ok),
        0,
        15
    )

    display.text(
        "MCP #1 " + post_status(ENABLE_MCP_1, mcp1_ok),
        0,
        27
    )

    display.text(
        "MCP #2 " + post_status(ENABLE_MCP_2, mcp2_ok),
        0,
        39
    )

    display.text(
        "AUX TCA " + post_status(True, tca_ok),
        0,
        51
    )

    display.show()

def run_hardware_post():
    try:
        main_scan = i2c_main.scan()
    except OSError:
        main_scan = []

    try:
        aux_scan = i2c_aux.scan()
    except OSError:
        aux_scan = []

    print("POST I2C0:", main_scan)
    print("POST I2C1:", aux_scan)

    return (
        MAIN_OLED_ADDRESS in main_scan,
        MCP_1_ADDRESS in main_scan,
        MCP_2_ADDRESS in main_scan,
        TCA9548A_ADDRESS in aux_scan
    )

# ==================================================
# DISPLAY ERROR PROTECTION
#
# If a screen update fails, skip it, remember to
# retry shortly, and keep the program running.
# ==================================================

display_retry_needed = False
last_display_retry_time = 0
last_display_error_print_time = 0
# Remembers what each screen last showed, so unchanged
# screens are not sent again.
last_main_buffer = bytearray(DISPLAY_WIDTH * DISPLAY_HEIGHT // 8)
main_cache_valid = False

last_small_content = [None, None, None, None, None, None]


def invalidate_display_cache():
    # Forget what the screens show, so the next update
    # redraws all of them.
    global main_cache_valid

    main_cache_valid = False

    for index in range(NUMBER_OF_ENCODERS):
        last_small_content[index] = None

def report_display_error(name, error):
    # Prints at most once every 2 seconds, so a
    # disconnected screen does not flood the console.
    global last_display_error_print_time

    now = utime.ticks_ms()

    if utime.ticks_diff(
        now,
        last_display_error_print_time
    ) >= 2000:
        last_display_error_print_time = now
        print("Display update failed:", name, error)
# ==================================================
# MAIN OLED DRAWING
#
# Fine control descriptions remain on small OLEDs.
# ==================================================

def draw_header(title):
    display.fill_rect(
        0,
        0,
        DISPLAY_WIDTH,
        16,
        0
    )

    display.text(title[:16], 0, 0)

    display.hline(
        0,
        15,
        DISPLAY_WIDTH,
        1
    )


def draw_menu_browser():
    draw_header("MENU")

    previous_page = wrap(
        menu_selected_page - 1,
        0,
        NUMBER_OF_PAGES - 1
    )

    selected_name = PAGE_NAMES[
        menu_selected_page
    ]

    next_page = wrap(
        menu_selected_page + 1,
        0,
        NUMBER_OF_PAGES - 1
    )

    display.text(
        PAGE_NAMES[previous_page][:16],
        0,
        21
    )

    display.fill_rect(
        0,
        32,
        DISPLAY_WIDTH,
        12,
        1
    )

    display.text(
        selected_name[:16],
        3,
        34,
        0
    )

    display.text(
        PAGE_NAMES[next_page][:16],
        0,
        49
    )


def draw_decade_box_page():
    draw_header("DECADE BOX")

    value_text = resistance_string()

    # Correct centered layout:
    # 0 through 999,999 can use 2x scaling.
    if not extra_one_meg_enabled:
        text_x = text_center_x(value_text, 2)

        big_text(
            display,
            value_text,
            text_x,
            24,
            2
        )

    # 1,000,000 through 1,999,999:
    # one horizontal scale, two vertical scale.
    else:
        text_x = text_center_x(value_text, 1)

        big_text_stretched(
            display,
            value_text,
            text_x,
            24,
            1,
            2
        )

    draw_omega(
        (DISPLAY_WIDTH - 10) // 2,
        50,
        1
    )


def draw_meters_page():
    draw_header("LIVE METERS")

    if ina238_ready:
        rows = (
            "I: " + current_string(measured_current_amps),
            "V: " + voltage_string(measured_voltage_volts),
            "P: " + power_string(measured_power_watts)
        )
    else:
        rows = (
            "I: ---",
            "V: ---",
            "P: ---"
        )

    row_y = (22, 37, 52)

    for row_number in range(3):
        if row_number == meter_view:
            display.fill_rect(
                0,
                row_y[row_number] - 1,
                DISPLAY_WIDTH,
                11,
                1
            )

            display.text(
                rows[row_number],
                2,
                row_y[row_number],
                0
            )

        else:
            display.text(
                rows[row_number],
                2,
                row_y[row_number],
                1
            )


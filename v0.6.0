def run_main_oled_test():
    display.fill(1)
    display.show()
    utime.sleep_ms(300)

    display.fill(0)
    display.show()
    utime.sleep_ms(300)


def run_aux_oled_test():
    if not ENABLE_ENCODER_DISPLAYS:
        return

    for channel_number in range(NUMBER_OF_ENCODERS):
        oled = small_displays[channel_number]

        if oled is None:
            continue

        if tca_select_channel(channel_number):
            oled.fill(1)
            oled.show()

    utime.sleep_ms(300)

    for channel_number in range(NUMBER_OF_ENCODERS):
        oled = small_displays[channel_number]

        if oled is None:
            continue

        if tca_select_channel(channel_number):
            oled.fill(0)
            oled.show()

    tca_disable_all_channels()


def run_i2c_scan_test():
    rescan_i2c_buses()
    print_scan_report()

    try:
        draw_scan_screen()
    except OSError as error:
        report_display_error("MAIN OLED", error)

    # Stay on the scan screen until any button is pressed
    # (gives up after 30 seconds).
    utime.sleep_ms(300)
    start_time = utime.ticks_ms()

    while utime.ticks_diff(utime.ticks_ms(), start_time) < 30000:
        if any_button_down():
            break

        utime.sleep_ms(10)

    # Wait for release, so that press is not used twice.
    while any_button_down():
        utime.sleep_ms(10)

    utime.sleep_ms(50)

# ==================================================
# RELAY STEP TEST (bring-up tool)
#
# Energizes ONE output at a time, 32 in total:
#   outputs 0-15  = MCP #1 bits 0-15
#   outputs 16-31 = MCP #2 bits 0-15
# Turn ENCODER 1 to step. Press ENCODER 1 to exit.
# Press ENCODER 2 to hold the output relay K1 closed.
# Everything is switched off again on exit.
# ==================================================

RELAY_STEP_COUNT = 32

DECADE_LABELS = ("1R", "10R", "100R", "1K", "10K", "100K")


def relay_expected_text(index):
    # What the project brief says this output should be.
    if index < 24:
        return "EXP: " + DECADE_LABELS[index // 4] + " decade"

    if index == 24:
        return "EXP: 1M REVERSED"

    if index == 25:
        return "EXP: K1 OUTPUT"

    if index == 26:
        return "EXP: INT FAN EN?"

    if index == 27:
        return "EXP: FAN HI/LO?"

    if index == 28:
        return "EXP: LIGHT_EN?"

    return "EXP: J5 SPARE"


def relay_step_apply(index, k1_hold):
    # Everything off first, so two relays are never on together.
    relays_all_off()

    word_1 = 0
    word_2 = 0

    if index < 16:
        word_1 = 1 << index
    else:
        word_2 = 1 << (index - 16)

    if k1_hold:
        word_2 |= (1 << 9)

    mcp_write_16_outputs(MCP_1_ADDRESS, word_1)
    mcp_write_16_outputs(MCP_2_ADDRESS, word_2)


def relay_step_show(index, k1_hold):
    if index < 16:
        chip_number = 1
        chip_address = MCP_1_ADDRESS
    else:
        chip_number = 2
        chip_address = MCP_2_ADDRESS

    bit = index % 16

    if bit < 8:
        port_letter = "A"
        pin_number = bit
    else:
        port_letter = "B"
        pin_number = bit - 8

    try:
        display.fill(0)
        display.text("RELAY STEP TEST", 0, 0)

        if mcp_is_ready(chip_address):
            display.text(
                "OUTPUT {} OF 32".format(index + 1),
                0,
                11
            )
        else:
            display.text(
                "MCP{} NOT READY".format(chip_number),
                0,
                11
            )

        display.text(
            "MCP{} GP{}{} bit {}".format(
                chip_number,
                port_letter,
                pin_number,
                bit
            ),
            0,
            22
        )

        display.text(relay_expected_text(index), 0, 33)

        display.text(
            "ENC2:K1 HOLD " + ("ON" if k1_hold else "OFF"),
            0,
            44
        )

        display.text("ENC1 PRESS=EXIT", 0, 55)
        display.show()

    except OSError as error:
        report_display_error("MAIN OLED", error)


def run_relay_step_test():
    global relay_test_active

    relay_test_active = False

    index = 0
    k1_hold = False

    while any_button_down():
        utime.sleep_ms(10)

    try:
        relay_step_apply(index, k1_hold)
        relay_step_show(index, k1_hold)

        while True:
            changed = False
            direction = 0

            # Read every encoder so none is left with stale state,
            # but only encoder 1 is used.
            for encoder_number in range(NUMBER_OF_ENCODERS):
                result = read_encoder_direction(encoder_number)

                if encoder_number == ENCODER_1:
                    direction = result

            if direction != 0:
                index = wrap(
                    index + direction,
                    0,
                    RELAY_STEP_COUNT - 1
                )
                changed = True

            # Encoder 1 button: exit.
            if sw_pins[ENCODER_1].value() == 0:
                utime.sleep_ms(30)

                if sw_pins[ENCODER_1].value() == 0:
                    break

            # Encoder 2 button: toggle K1 hold.
            if sw_pins[ENCODER_2].value() == 0:
                utime.sleep_ms(30)

                if sw_pins[ENCODER_2].value() == 0:
                    k1_hold = not k1_hold
                    changed = True

                    while sw_pins[ENCODER_2].value() == 0:
                        utime.sleep_ms(10)

            if changed:
                relay_step_apply(index, k1_hold)
                relay_step_show(index, k1_hold)

            utime.sleep_ms(1)

    finally:
        # Always leave the box in the safe state.
        relays_all_off()

        while any_button_down():
            utime.sleep_ms(10)

        utime.sleep_ms(50)

# ==================================================
# MCP #3 INPUT TEST (read-only bring-up tool)
#
# Shows the live state of all 16 pins of MCP #3.
# Writes NOTHING to the chip.
# Press ENCODER 1 to exit.
# Port A: bit 0 = light switch, 1 = left door,
#         2 = right door (all active-low).
# ==================================================

def run_mcp3_input_test():
    while any_button_down():
        utime.sleep_ms(10)

    last_a = None
    last_b = None
    last_failed = None

    while True:
        failed = False
        value_a = 0
        value_b = 0

        if mcp_is_ready(MCP_3_ADDRESS):
            try:
                value_a = mcp_read_register(MCP_3_ADDRESS, MCP_GPIOA)
                value_b = mcp_read_register(MCP_3_ADDRESS, MCP_GPIOB)
            except OSError:
                failed = True
        else:
            failed = True

        if (
            value_a != last_a or
            value_b != last_b or
            failed != last_failed
        ):
            last_a = value_a
            last_b = value_b
            last_failed = failed

            if not failed:
                print(
                    "MCP3  A:{:08b}  B:{:08b}".format(value_a, value_b)
                )

            try:
                display.fill(0)
                display.text("MCP3 ENC1 EXITS", 0, 0)

                if failed:
                    display.text("NOT READY/FAILED", 0, 22)
                else:
                    display.text("A " + "{:08b}".format(value_a), 0, 11)
                    display.text("B " + "{:08b}".format(value_b), 0, 22)

                    display.text(
                        "LIGHT SW " +
                        ("PRESSED" if (value_a & 0x01) == 0 else "off"),
                        0,
                        33
                    )

                    display.text(
                        "L DOOR " +
                        ("MAGNET" if (value_a & 0x02) == 0 else "none"),
                        0,
                        44
                    )

                    display.text(
                        "R DOOR " +
                        ("MAGNET" if (value_a & 0x04) == 0 else "none"),
                        0,
                        55
                    )

                display.show()

            except OSError as error:
                report_display_error("MAIN OLED", error)

        # Encoder 1 button: exit.
        if sw_pins[ENCODER_1].value() == 0:
            utime.sleep_ms(30)

            if sw_pins[ENCODER_1].value() == 0:
                break

        utime.sleep_ms(20)

    while any_button_down():
        utime.sleep_ms(10)

    utime.sleep_ms(50)

def run_selected_test():
    global settings_view
    global active_page

    if test_selected_item == TEST_RELAY_ALL_ON:
        # Toggle behavior:
        # first press starts relay test
        # second press stops relay test.
        if relay_test_active:
            relay_test_stop()
        else:
            relay_test_all_on()

    elif test_selected_item == TEST_RELAY_STOP:
        relay_test_stop()

    elif test_selected_item == TEST_MAIN_OLED:	```
        run_main_oled_test()

    elif test_selected_item == TEST_AUX_OLEDS:
        run_aux_oled_test()

    elif test_selected_item == TEST_DOOR_INPUTS:
        active_page = PAGE_SENSORS
        settings_view = SETTINGS_VIEW_CONFIG

    elif test_selected_item == TEST_I2C_SCAN:
        run_i2c_scan_test()
        
    elif test_selected_item == TEST_RELAY_STEP:
        run_relay_step_test()
        
    elif test_selected_item == TEST_MCP3_INPUTS:
        run_mcp3_input_test()
        
    elif test_selected_item == TEST_INA238:
        run_ina238_test()
        
    elif test_selected_item == TEST_RETURN_CONFIG:
        settings_view = SETTINGS_VIEW_CONFIG
        
    
    # Tests draw on the screens directly, so force a redraw.
    invalidate_display_cache()    


# ==================================================
# BUTTON ACTIONS
# ==================================================

def handle_short_button_press(button_number):
    global extra_one_meg_enabled
    global relay_update_pending
    global last_value_change_time
    global meter_view
    global custom_white
    global active_page
    global settings_view
    global fan_mode

    # MENU BROWSER:
    # Encoder 6 = enter.
    # Encoder 5 = cancel/back.
    if menu_browser_active:
        if button_number == ENCODER_6:
            enter_selected_page()

        elif button_number == ENCODER_5:
            close_menu_browser()

        return

    # Encoder 6 opens global menu on active pages,
    # except Settings where its rotation is used to
    # select an item but its button still opens Menu.
    if button_number == ENCODER_6:
        open_menu_browser()
        return

    # ------------------------------------------------
    # DECADE BOX BUTTONS
    # ------------------------------------------------
    if active_page == PAGE_DECADE_BOX:
        if button_number == ENCODER_1:
            extra_one_meg_enabled = (
                not extra_one_meg_enabled
            )

            relay_update_pending = True
            last_value_change_time = utime.ticks_ms()

        # Encoder 5 button: direct meter shortcut.
        elif button_number == ENCODER_5:
            active_page = PAGE_METERS

        # Optional alternate shortcut requested earlier:
        # uncomment later if Encoder 2 button should also
        # open the meter from Decade Box.
        #
        # elif button_number == ENCODER_2:
        #     active_page = PAGE_METERS

    # ------------------------------------------------
    # LIVE METERS BUTTONS
    # ------------------------------------------------
    elif active_page == PAGE_METERS:
        if button_number == ENCODER_2:
            meter_view = wrap(
                meter_view + 1,
                METER_VIEW_CURRENT,
                METER_VIEW_POWER
            )

        elif button_number == ENCODER_5:
            active_page = PAGE_DECADE_BOX

    # ------------------------------------------------
    # LIGHTING BUTTONS
    # ------------------------------------------------
    elif active_page == PAGE_LIGHTING:
        # Encoder 4 button cycles custom White channel.
        if button_number == ENCODER_4:
            custom_white += 25

            if custom_white > 255:
                custom_white = 0

            mark_settings_unsaved()
            apply_lighting_mode()

    # ------------------------------------------------
    # CLIMATE BUTTONS
    # ------------------------------------------------
    elif active_page == PAGE_CLIMATE:
        if button_number == ENCODER_1:
            fan_mode = wrap(
                fan_mode + 1,
                FAN_OFF,
                FAN_MANUAL
            )

    # ------------------------------------------------
    # SETTINGS BUTTONS
    # ------------------------------------------------
    elif active_page == PAGE_SETTINGS:
        if settings_view == SETTINGS_VIEW_CONFIG:
            # Encoder 2 button always saves, including
            # when Relay Delay is currently selected.
            if button_number == ENCODER_2:
                save_runtime_settings()

            # Only relevant if OPEN TESTS is selected.
            elif (
                button_number == ENCODER_4 and
                settings_selected_item == SETTINGS_OPEN_TESTS
            ):
                settings_view = SETTINGS_VIEW_TESTS

        else:
            # Test submenu:
            # Encoder 2 button runs / stops a test.
            if button_number == ENCODER_2:
                run_selected_test()

            # Button 4 is a direct return to configuration.
            elif button_number == ENCODER_4:
                settings_view = SETTINGS_VIEW_CONFIG


def handle_long_button_press(button_number):
    if (
        not menu_browser_active and
        active_page == PAGE_DECADE_BOX and
        button_number == ENCODER_3
    ):
        clear_all_decade_digits()


def read_buttons():
    action_occurred = False
    now = utime.ticks_ms()

    for button_number in range(NUMBER_OF_ENCODERS):
        pressed_now = (
            sw_pins[button_number].value() == 0
        )

        # New press.
        if (
            pressed_now and
            not button_was_pressed[button_number]
        ):
            elapsed = utime.ticks_diff(
                now,
                button_last_transition_time[
                    button_number
                ]
            )

            if elapsed >= BUTTON_DEBOUNCE_MS:
                button_was_pressed[
                    button_number
                ] = True

                button_press_time[
                    button_number
                ] = now

                button_long_press_done[
                    button_number
                ] = False

                button_last_transition_time[
                    button_number
                ] = now

        # Held press.
        if (
            pressed_now and
            button_was_pressed[button_number]
        ):
            held_time = utime.ticks_diff(
                now,
                button_press_time[button_number]
            )

            if (
                held_time >= ZERO_ALL_HOLD_MS and
                not button_long_press_done[
                    button_number
                ]
            ):
                button_long_press_done[
                    button_number
                ] = True

                handle_long_button_press(
                    button_number
                )

                action_occurred = True

        # Release.
        if (
            not pressed_now and
            button_was_pressed[button_number]
        ):
            elapsed = utime.ticks_diff(
                now,
                button_last_transition_time[
                    button_number
                ]
            )

            if elapsed >= BUTTON_DEBOUNCE_MS:
                if not button_long_press_done[
                    button_number
                ]:
                    handle_short_button_press(
                        button_number
                    )

                    action_occurred = True

                button_was_pressed[
                    button_number
                ] = False

                button_long_press_done[
                    button_number
                ] = False

                button_last_transition_time[
                    button_number
                ] = now

    return action_occurred



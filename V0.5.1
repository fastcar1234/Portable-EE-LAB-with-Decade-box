# ==================================================
# RELAY CONTROL
# ==================================================

def update_relays():
    # Do not apply normal relay mapping while the relay
    # test function intentionally holds all outputs on.
    if relay_test_active:
        return

    relay_bits = 0

    for decade in range(NUMBER_OF_ENCODERS):
        relay_bits |= (
            (digits[decade] & 0x0F) <<
            (decade * 4)
        )

    if extra_one_meg_enabled:
        relay_bits |= (1 << 24)

    # MCP #1 gets relay bits 0..15.
    mcp_write_16_outputs(
        MCP_1_ADDRESS,
        relay_bits & 0xFFFF
    )

    # MCP #2:
    #
    # Port A = relay bits 16..23.
    # Port B bit 0 / bit 1 are configured as inputs, so
    # their written output latch state does not drive them.
    #
    # 1 MOhm relay uses MCP #2 GPB0 in the old map, but
    # GPB0 is now a door input. Therefore this framework
    # maps the 1 MOhm relay to GPB2, output-word bit 10.
    #
    # IMPORTANT:
    # Move the physical 1M ULN2803 control wire from GPB0
    # to GPB2 when you wire the door inputs.
    relay_word_2 = (
        (relay_bits >> 16) & 0x00FF
    )

    if extra_one_meg_enabled:
        relay_word_2 |= (1 << 10)

    mcp_write_16_outputs(
        MCP_2_ADDRESS,
        relay_word_2
    )


def relay_test_all_on():
    global relay_test_active

    relay_test_active = True

    # MCP #1: all sixteen relay outputs on.
    mcp_write_16_outputs(
        MCP_1_ADDRESS,
        0xFFFF
    )

    # MCP #2:
    # Port A all on.
    # Port B:
    # GPB0 / GPB1 are DOOR INPUTS, leave them irrelevant.
    # GPB2-GPB7 outputs on.
    mcp_write_16_outputs(

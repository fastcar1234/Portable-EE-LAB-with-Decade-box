def load_settings():
    loaded = {}

    for key in DEFAULT_SETTINGS:
        loaded[key] = DEFAULT_SETTINGS[key]

    try:
        file_handle = open(
            SETTINGS_FILENAME,
            "r"
        )

        file_data = json.load(file_handle)
        file_handle.close()

        for key in DEFAULT_SETTINGS:
            if key in file_data:
                loaded[key] = file_data[key]

        print("Saved settings applied")
        return loaded, True

    except Exception as error:
        print("No saved settings:", error)
        return loaded, False


def delete_file_if_present(filename):
    if os is None:
        return

    try:
        os.remove(filename)
    except OSError:
        pass


def save_settings_file():
    global settings_unsaved
    global settings_message

    try:
        delete_file_if_present(
            SETTINGS_TEMP_FILENAME
        )

        temporary_file = open(
            SETTINGS_TEMP_FILENAME,
            "w"
        )

        json.dump(settings, temporary_file)
        temporary_file.close()

        # Verify temporary JSON before replacing active file.
        verify_file = open(
            SETTINGS_TEMP_FILENAME,
            "r"
        )

        verified_data = json.load(verify_file)
        verify_file.close()

        if "relay_delay_ms" not in verified_data:
            raise Exception("settings verify failed")

        delete_file_if_present(SETTINGS_FILENAME)

        if os is not None:
            os.rename(
                SETTINGS_TEMP_FILENAME,
                SETTINGS_FILENAME
            )
        else:
            # Fallback for unusual MicroPython builds.
            final_file = open(
                SETTINGS_FILENAME,
                "w"
            )

            json.dump(verified_data, final_file)
            final_file.close()

            delete_file_if_present(
                SETTINGS_TEMP_FILENAME
            )

        # Final verification after rename.
        final_verify_file = open(
            SETTINGS_FILENAME,
            "r"
        )

        final_verify_data = json.load(
            final_verify_file
        )

        final_verify_file.close()

        if "relay_delay_ms" not in final_verify_data:
            raise Exception("final verify failed")

        settings_unsaved = False
        settings_message = "SAVED"

        print("Settings saved and verified")

    except Exception as error:
        settings_message = "SAVE ERROR"
        print("Settings save error:", error)



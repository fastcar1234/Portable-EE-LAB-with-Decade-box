# ==================================================

def tca_select_channel(channel_number):
    if channel_number < 0 or channel_number > 7:
        return False

    try:
        i2c_aux.writeto(
            TCA9548A_ADDRESS,
            bytes([1 << channel_number])
        )

        return True

    except OSError as error:
        if i2c_debug_enabled:
            print(
                "TCA select error:",
                channel_number,
                error
            )

        return False


def tca_disable_all_channels():
    try:
        i2c_aux.writeto(
            TCA9548A_ADDRESS,
            bytes([0x00])
        )

    except OSError:
        pass


# One persistent display object per TCA channel.
# This prevents repeated initialization lag.
small_displays = [
    None,
    None,
    None,
    None,
    None,
    None
]


def initialize_small_displays():
    if not ENABLE_ENCODER_DISPLAYS:
        return

    for channel_number in range(NUMBER_OF_ENCODERS):
        if not tca_select_channel(channel_number):
            continue

        try:
            small_displays[channel_number] = (
                SSD1306_I2C(
                    SMALL_DISPLAY_WIDTH,
                    SMALL_DISPLAY_HEIGHT,
                    i2c_aux,
                    addr=SMALL_OLED_ADDRESS
                )
            )

            set_oled_brightness(
                small_displays[channel_number],
                aux_oled_brightness
            )

        except OSError as error:
            small_displays[channel_number] = None

            if i2c_debug_enabled:
                print(
                    "Small OLED init error:",
                    channel_number,
                    error
                )

    tca_disable_all_channels()



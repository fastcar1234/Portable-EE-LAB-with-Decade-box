# ==================================================
# MCP23017 FUNCTIONS
# ==================================================

def mcp_write_register(address, register, value):
    try:
        i2c_main.writeto_mem(
            address,
            register,
            bytes([value & 0xFF])
        )
        return True
    except OSError as error:
        print("MCP write failed:", hex(address), error)
        return False


def mcp_read_register(address, register):
    result = i2c_main.readfrom_mem(
        address,
        register,
        1
    )

    return result[0]

def mcp_setup_devices():
    # MCP #1: all sixteen pins are relay outputs.
    mcp_write_register(
        MCP_1_ADDRESS,
        MCP_IODIRA,
        0x00
    )

    mcp_write_register(
        MCP_1_ADDRESS,
        MCP_IODIRB,
        0x00
    )

    mcp_write_register(
        MCP_1_ADDRESS,
        MCP_OLATA,
        0x00
    )

    mcp_write_register(
        MCP_1_ADDRESS,
        MCP_OLATB,
        0x00
    )

    # MCP #2 Port A: all relay outputs.
    mcp_write_register(
        MCP_2_ADDRESS,
        MCP_IODIRA,
        0x00
    )

    # MCP #2 Port B:
    # GPB2 and GPB3 are door inputs.
    # Remaining bits are outputs/reserved.
    mcp_write_register(
        MCP_2_ADDRESS,
        MCP_IODIRB,
        DOOR_INPUT_MASK
    )

    # Internal pull-ups enabled for GPB2/GPB3.
    mcp_write_register(
        MCP_2_ADDRESS,
        MCP_GPPUB,
        DOOR_INPUT_MASK
    )

    mcp_write_register(
        MCP_2_ADDRESS,
        MCP_OLATA,
        0x00
    )

    mcp_write_register(
        MCP_2_ADDRESS,
        MCP_OLATB,
        0x00
    )


def mcp_write_16_outputs(address, output_word):
    mcp_write_register(
        address,
        MCP_OLATA,
        output_word & 0xFF
    )

    mcp_write_register(
        address,
        MCP_OLATB,
        (output_word >> 8) & 0xFF
    )


def read_door_inputs():
    try:
        port_b_value = mcp_read_register(
            MCP_2_ADDRESS,
            MCP_GPIOB
        )

        # Active-low:
        # Low = closed switch
        # High = open door / no ground path
        left_is_open = (
            (port_b_value & LEFT_DOOR_MASK) != 0
        )

        right_is_open = (
            (port_b_value & RIGHT_DOOR_MASK) != 0
        )

        return left_is_open, right_is_open

    except OSError:
        # Failed sensor read is treated as unsafe.
        return True, True



                "MOVE",
                "EXT / RET",
                "",
                2
            ),
            (
                "SPEED",
                str(actuator_speed_percent) + "%",
                "",
                2
            ),
            (
                "POSITION",
                str(actuator_position_percent) + "%",
                "",
                2
            ),
            (
                "ENABLE",
                "ON" if actuator_enabled else "OFF",
                "",
                2
            ),
            blank,
            (
                "PRESS",
                "MENU",
                "",
                2
            )
        )

    if active_page == PAGE_SENSORS:
        return (
            (
                "TOOL SELECT",
                "T" + str(selected_tool + 1),
                "",
                2
            ),
            (
                "SENSOR MODE",
                SENSOR_MODE_NAMES[sensor_mode],
                "",
                2
            ),
            (
                "LEFT DOOR",
                "OPEN" if left_door_open else "CLOSED",
                "",
                2
            ),
            (
                "RIGHT DOOR",
                "OPEN" if right_door_open else "CLOSED",
                "",
                2
            ),
            blank,
            (
                "PRESS",
                "MENU",
                "",
                2
            )
        )

    # SETTINGS PAGE
    if settings_view == SETTINGS_VIEW_CONFIG:
        test_line = ""

        if settings_selected_item == SETTINGS_OPEN_TESTS:
            test_line = "PRESS BUTTON 4"

        return (
            (
                "SETTINGS",
                "TURN SELECT",
                "",
                2
            ),
            (
                "EDIT VALUE",
                settings_value_string(),
                "PRESS SAVE",
                2
            ),
            blank,
            (
                "TESTS",
                test_line,
                "",
                2 if test_line != "" else 0
            ),
            blank,
            (
                "PRESS",
                "MENU",
                "",
                2
            )
        )

    # SETTINGS TEST VIEW
    test_action_text = "RUN TEST"

    if (
        relay_test_active and
        test_selected_item == TEST_RELAY_ALL_ON
    ):
        test_action_text = "STOP TEST"

    return (
        (
            "SELECT TEST",
            TEST_ITEM_NAMES[test_selected_item],
            "",
            2
        ),
        (
            "PRESS BUTTON",
            test_action_text,
            "",
            2
        ),
        blank,
        (
            "DOOR STATE",
            "SEE MAIN OLED",
            "",
            2
        ),
        (
            "RETURN CONFIG",
            "SELECT ABOVE",
            "",
            2
        ),
        (
            "PRESS",
            "MENU",
            "",
            2
        )
    )


def draw_small_oled(
    oled,
    top_line,
    middle_line,
    bottom_line,
    highlight_line
):
    # A 128x32 display has four 8-pixel text rows.
    # Three centered text rows use most of its physical
    # area while retaining clean spacing.
    oled.fill(0)

    lines = (
        (top_line, 0, 1),
        (middle_line, 11, 2),
        (bottom_line, 22, 3)
    )

    for text, y_position, line_number in lines:
        if text == "":
            continue

        shown_text = short_text(text)
        x_position = small_text_center_x(shown_text)

        if highlight_line == line_number:
            oled.fill_rect(
                0,
                y_position - 1,
                SMALL_DISPLAY_WIDTH,
                10,
                1
            )

            oled.text(
                shown_text,
                x_position,
                y_position,
                0
            )

        else:
            oled.text(
                shown_text,
                x_position,
                y_position,
                1
            )

    oled.show()


def update_small_displays(force=False):
    # Called only for a user-visible UI change.
    # Only screens whose text changed are redrawn.
    global display_retry_needed

    if not ENABLE_ENCODER_DISPLAYS:
        return

    display_data = small_display_content()
    channel_was_used = False

    for channel_number in range(NUMBER_OF_ENCODERS):
        oled = small_displays[channel_number]

        if oled is None:
            continue

        new_content = display_data[channel_number]

        if (
            not force and
            new_content == last_small_content[channel_number]
        ):
            continue

        try:
            channel_was_used = True

            if not tca_select_channel(channel_number):
                last_small_content[channel_number] = None
                display_retry_needed = True
                continue

            draw_small_oled(
                oled,
                new_content[0],
                new_content[1],
                new_content[2],
                new_content[3]
            )

            last_small_content[channel_number] = new_content

        except OSError as error:
            last_small_content[channel_number] = None
            display_retry_needed = True
            report_display_error(
                "SMALL OLED " + str(channel_number + 1),
                error
            )

    if channel_was_used:
        tca_disable_all_channels()
        
        
# ==================================================
# DECADE RELAY OUTPUTS
# ==================================================

def update_relays():
    if relay_test_active:
        return
    # Held back until step 4b confirms the real relay map.
    if not RELAY_MAP_VERIFIED:
        return

    relay_bits = 0

    for decade in range(NUMBER_OF_ENCODERS):
        relay_bits |= (
            (digits[decade] & 0x0F) <<
            (decade * 4)
        )

    if extra_one_meg_enabled:
        relay_bits |= (1 << 24)

    # MCP #1 gets bits 0 through 15.
    mcp_write_16_outputs(
        MCP_1_ADDRESS,
        relay_bits & 0xFFFF
    )

    # MCP #2:
    # GPA0-GPA7 = bits 16-23.
    # GPB0 / GPB1 = available outputs.
    # GPB2 / GPB3 = door inputs.
    # GPB4 = +1M relay output.
    #
    # This keeps the two door inputs away from GPB0/GPB1
    # as requested, while placing 1M on GPB4.
    relay_word_2 = (
        (relay_bits >> 16) & 0x00FF
    )

    if extra_one_meg_enabled:
        relay_word_2 |= (1 << 12)

    mcp_write_16_outputs(
        MCP_2_ADDRESS,
        relay_word_2
    )

def relays_all_off():
    # Safe state: all decades out (0 ohm), 1M in circuit,
    # output relay off, fan and light enables off.
    for address in (MCP_1_ADDRESS, MCP_2_ADDRESS):
        mcp_write_register(address, MCP_OLATA, 0x00)
        mcp_write_register(address, MCP_OLATB, 0x00)


def relay_test_all_on():
    global relay_test_active

    relay_test_active = True

    # Only the six decade relays. MCP #2 port B stays LOW,
    # so K1, fan enables, light enable and the 1M relay
    # are not touched.
    mcp_write_16_outputs(MCP_1_ADDRESS, 0xFFFF)
    mcp_write_16_outputs(MCP_2_ADDRESS, 0x00FF)

    print("Relay test active (decade relays only)")


def relay_test_stop():
    global relay_test_active

    relay_test_active = False

    if RELAY_MAP_VERIFIED:
        update_relays()
    else:
        relays_all_off()

    print("Relay test stopped")
def service_delayed_relay_update():
    global relay_update_pending

    if not relay_update_pending:
        return

    elapsed = utime.ticks_diff(
        utime.ticks_ms(),
        last_value_change_time
    )

    if elapsed >= RELAY_SETTLE_DELAY_MS:
        update_relays()

        relay_update_pending = False


# ==================================================
# LIVE METER FUNCTIONS
# ==================================================

def update_measurements():
    global measured_voltage_volts
    global measured_current_amps
    global measured_power_watts
    global ina238_ready

    if ENABLE_CURRENT_VOLTAGE_METER and ina238_ready:
        try:
            shunt_raw, vbus_raw = ina238_read_raw()

            measured_voltage_volts = (
                vbus_raw * INA238_VBUS_LSB_VOLTS
            )

            measured_current_amps = (
                shunt_raw * INA238_SHUNT_LSB_VOLTS *
                INA238_CURRENT_SIGN / INA238_SHUNT_OHMS
            )

        except OSError as error:
            # The re-scan sets the chip up again when it answers.
            ina238_ready = False
            print("INA238 read failed:", error)

    if not ina238_ready:
        measured_voltage_volts = 0.0
        measured_current_amps = 0.0

    measured_power_watts = (
        measured_voltage_volts *
        measured_current_amps
    )

# ==================================================
# TEMPERATURE / FAN FUNCTIONS
# ==================================================

def update_temperature():
    global temperature_celsius

    if ENABLE_TEMPERATURE_SENSOR:
        # Future temperature-sensor code.
        pass

    else:
        temperature_celsius = 24.0


def calculate_fan_target_percent():
    if fan_mode == FAN_OFF:
        return 0

    if fan_mode == FAN_LOW:
        return fan_low_percent

    if fan_mode == FAN_MEDIUM:
        return fan_medium_percent

    if fan_mode == FAN_MANUAL:
        return fan_manual_percent

    if temperature_celsius <= fan_auto_start_c:
        return 0

    if temperature_celsius >= fan_auto_full_c:
        return 100

    span = (
        fan_auto_full_c -
        fan_auto_start_c
    )

    if span <= 0:
        return 100

    return (
        (temperature_celsius - fan_auto_start_c) *
        100
    ) // span


def service_fan_ramp():
    global fan_target_percent
    global fan_actual_percent
    global fan_last_ramp_time

    fan_target_percent = (
        calculate_fan_target_percent()
    )

    elapsed = utime.ticks_diff(
        utime.ticks_ms(),
        fan_last_ramp_time
    )

    if elapsed < fan_ramp_interval_ms:
        return

    fan_last_ramp_time = utime.ticks_ms()

    if fan_actual_percent < fan_target_percent:
        fan_actual_percent += fan_ramp_step_percent

        if fan_actual_percent > fan_target_percent:
            fan_actual_percent = fan_target_percent

    elif fan_actual_percent > fan_target_percent:
        fan_actual_percent -= fan_ramp_step_percent

        if fan_actual_percent < fan_target_percent:
            fan_actual_percent = fan_target_percent

    if fan_pwm is not None:
        fan_pwm.duty_u16(
            percent_to_duty_u16(
                fan_actual_percent
            )
        )



def tca_select_channel(channel_number):
    if channel_number < 0 or channel_number > 7:
        return False

    try:
        i2c_aux.writeto(
            TCA9548A_ADDRESS,
            bytes([1 << channel_number])
        )

        return True

    except OSError as error:
        if i2c_debug_enabled:
            print(
                "TCA channel error:",
                channel_number,
                error
            )

        return False


def tca_disable_all_channels():
    try:
        i2c_aux.writeto(
            TCA9548A_ADDRESS,
            bytes([0x00])
        )

    except OSError:
        pass


def create_small_oled(channel_number):
    if not tca_select_channel(channel_number):
        return None

    try:
        return SSD1306_I2C(
            SMALL_DISPLAY_WIDTH,
            SMALL_DISPLAY_HEIGHT,
            i2c_aux,
            addr=SMALL_OLED_ADDRESS
        )

    except OSError as error:
        if i2c_debug_enabled:
            print(
                "Small OLED error:",
                channel_number,
                error
            )

        return None



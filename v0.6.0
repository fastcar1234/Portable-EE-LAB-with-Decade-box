# ==================================================
# MCP #2 PORT B MAP
#
# GPB0 = relay output, reserved
# GPB1 = relay output, reserved
# GPB2 = left-door sensor input
# GPB3 = right-door sensor input
# GPB4-GPB7 = remaining spare I/O
#
# Active-low input scheme:
# LOW  = door closed / switch pressed
# HIGH = door open / wire fault / no switch contact
# ==================================================

LEFT_DOOR_BIT = 2
RIGHT_DOOR_BIT = 3

LEFT_DOOR_MASK = 1 << LEFT_DOOR_BIT
RIGHT_DOOR_MASK = 1 << RIGHT_DOOR_BIT

DOOR_INPUT_MASK = (
    LEFT_DOOR_MASK |
    RIGHT_DOOR_MASK
)



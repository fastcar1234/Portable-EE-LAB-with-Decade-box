# ==================================================
# SETTINGS VALUE FORMATTER
# ==================================================

def settings_value_string():
    if settings_selected_item == SETTINGS_RELAY_DELAY:
        return str(RELAY_SETTLE_DELAY_MS) + "ms"

    if settings_selected_item == SETTINGS_LED_PORTS:
        return str(LED_PORT_COUNT)

    if settings_selected_item == SETTINGS_LED_PIXELS:
        return str(LED_PIXELS_PER_PORT)

    if settings_selected_item == SETTINGS_LED_BRIGHTNESS:
        return str(lighting_brightness)

    if settings_selected_item == SETTINGS_MAIN_OLED_BRIGHTNESS:
        return str(main_oled_brightness)

    if settings_selected_item == SETTINGS_AUX_OLED_BRIGHTNESS:
        return str(aux_oled_brightness)

    if settings_selected_item == SETTINGS_FAN_LOW:
        return str(fan_low_percent) + "%"

    if settings_selected_item == SETTINGS_FAN_MEDIUM:
        return str(fan_medium_percent) + "%"

    if settings_selected_item == SETTINGS_FAN_MANUAL:
        return str(fan_manual_percent) + "%"

    if settings_selected_item == SETTINGS_FAN_START:
        return str(fan_auto_start_c) + "C"

    if settings_selected_item == SETTINGS_FAN_FULL:
        return str(fan_auto_full_c) + "C"

    if settings_selected_item == SETTINGS_FAN_RAMP_STEP:
        return str(fan_ramp_step_percent) + "%"

    if settings_selected_item == SETTINGS_FAN_RAMP_TIME:
        return str(fan_ramp_interval_ms) + "ms"

    if settings_selected_item == SETTINGS_METER_REFRESH:
        return str(meter_refresh_ms) + "ms"

    if settings_selected_item == SETTINGS_BOOT_SCREEN_TIME:
        return str(boot_screen_ms) + "ms"

    if settings_selected_item == SETTINGS_POST_SCREEN_TIME:
        return str(post_screen_ms) + "ms"

    if settings_selected_item == SETTINGS_I2C_DEBUG:
        if i2c_debug_enabled:
            return "ON"
        return "OFF"

    if settings_selected_item == SETTINGS_OPEN_TESTS:
        return "BUTTON 4"

    return ""


# ==================================================
# ENCODER HANDLERS
# ==================================================

def handle_decade_encoder(
    encoder_number,
    direction
):
    global relay_update_pending
    global last_value_change_time

    digits[encoder_number] += direction

    if digits[encoder_number] > 9:
        digits[encoder_number] = 0

    if digits[encoder_number] < 0:
        digits[encoder_number] = 9

    relay_update_pending = True
    last_value_change_time = utime.ticks_ms()


def handle_meter_encoder(
    encoder_number,
    direction
):
    global meter_view

    if encoder_number == ENCODER_2:
        meter_view = wrap(
            meter_view + direction,
            METER_VIEW_CURRENT,
            METER_VIEW_POWER
        )


def handle_lighting_encoder(
    encoder_number,
    direction
):
    global lighting_mode
    global lighting_brightness
    global custom_red
    global custom_green
    global custom_blue
    global lighting_selected_port

    if encoder_number == ENCODER_1:
        lighting_mode = wrap(
            lighting_mode + direction,
            LIGHT_OFF,
            LIGHT_CUSTOM
        )

    elif encoder_number == ENCODER_2:
        lighting_brightness = clamp(
            lighting_brightness + direction * 5,
            0,
            255
        )
        mark_settings_unsaved()

    elif encoder_number == ENCODER_3:
        custom_red = clamp(
            custom_red + direction * 5,
            0,
            255
        )
        mark_settings_unsaved()

    elif encoder_number == ENCODER_4:
        custom_green = clamp(
            custom_green + direction * 5,
            0,
            255
        )
        mark_settings_unsaved()

    elif encoder_number == ENCODER_5:
        custom_blue = clamp(
            custom_blue + direction * 5,
            0,
            255
        )
        mark_settings_unsaved()

    elif encoder_number == ENCODER_6:
        lighting_selected_port = wrap(
            lighting_selected_port + direction,
            0,
            LED_PORT_COUNT - 1
        )

    apply_lighting_mode()


def handle_climate_encoder(
    encoder_number,
    direction
):
    global fan_mode
    global fan_low_percent
    global fan_medium_percent
    global fan_auto_start_c
    global fan_auto_full_c

    if encoder_number == ENCODER_1:
        fan_mode = wrap(
            fan_mode + direction,
            FAN_OFF,
            FAN_MANUAL
        )

    elif encoder_number == ENCODER_2:
        fan_low_percent = clamp(
            fan_low_percent + direction * 5,
            0,
            100
        )
        mark_settings_unsaved()

    elif encoder_number == ENCODER_3:
        fan_medium_percent = clamp(
            fan_medium_percent + direction * 5,
            0,
            100
        )
        mark_settings_unsaved()

    elif encoder_number == ENCODER_4:
        fan_auto_start_c = clamp(
            fan_auto_start_c + direction,
            10,
            70
        )
        mark_settings_unsaved()

    elif encoder_number == ENCODER_5:
        fan_auto_full_c = clamp(
            fan_auto_full_c + direction,
            fan_auto_start_c + 1,
            85
        )
        mark_settings_unsaved()


def handle_actuator_encoder(
    encoder_number,
    direction
):
    global actuator_speed_percent
    global actuator_position_percent
    global actuator_enabled

    if encoder_number == ENCODER_1:
        if direction > 0:
            set_actuator_state(
                ACTUATOR_EXTEND,
                True
            )
        else:
            set_actuator_state(
                ACTUATOR_RETRACT,
                True
            )

    elif encoder_number == ENCODER_2:
        actuator_speed_percent = clamp(
            actuator_speed_percent + direction * 5,
            0,
            100
        )

    elif encoder_number == ENCODER_3:
        actuator_position_percent = clamp(
            actuator_position_percent + direction * 5,
            0,
            100
        )

    elif encoder_number == ENCODER_4:
        actuator_enabled = not actuator_enabled

        if not actuator_enabled:
            set_actuator_state(
                ACTUATOR_STOP,
                False
            )


def handle_sensor_encoder(
    encoder_number,
    direction
):
    global selected_tool
    global sensor_mode

    if encoder_number == ENCODER_1:
        selected_tool = wrap(
            selected_tool + direction,
            0,
            len(tool_sensor_states) - 1
        )

    elif encoder_number == ENCODER_2:
        sensor_mode = wrap(
            sensor_mode + direction,
            SENSOR_MODE_SIMPLE,
            SENSOR_MODE_RFID
        )


def handle_settings_config_encoder(
    encoder_number,
    direction
):
    global settings_selected_item
    global RELAY_SETTLE_DELAY_MS
    global LED_PORT_COUNT
    global LED_PIXELS_PER_PORT
    global lighting_brightness
    global main_oled_brightness
    global aux_oled_brightness
    global fan_low_percent
    global fan_medium_percent
    global fan_manual_percent
    global fan_auto_start_c
    global fan_auto_full_c
    global fan_ramp_step_percent
    global fan_ramp_interval_ms
    global meter_refresh_ms
    global boot_screen_ms
    global post_screen_ms
    global i2c_debug_enabled
    global lighting_selected_port

    # Encoder 6 scrolls settings list, as requested.
    if encoder_number == ENCODER_6:
        settings_selected_item = wrap(
            settings_selected_item + direction,
            SETTINGS_RELAY_DELAY,
            SETTINGS_OPEN_TESTS
        )
        return

    # Encoder 2 edits the selected setting.
    if encoder_number != ENCODER_2:
        return

    if settings_selected_item == SETTINGS_RELAY_DELAY:
        RELAY_SETTLE_DELAY_MS = clamp(
            RELAY_SETTLE_DELAY_MS + direction * 50,
            0,
            3000
        )

    elif settings_selected_item == SETTINGS_LED_PORTS:
        LED_PORT_COUNT = clamp(
            LED_PORT_COUNT + direction,
            1,
            12
        )

        if lighting_selected_port >= LED_PORT_COUNT:
            lighting_selected_port = (
                LED_PORT_COUNT - 1
            )

    elif settings_selected_item == SETTINGS_LED_PIXELS:
        LED_PIXELS_PER_PORT = clamp(
            LED_PIXELS_PER_PORT + direction,
            1,
            300
        )

    elif settings_selected_item == SETTINGS_LED_BRIGHTNESS:
        lighting_brightness = clamp(
            lighting_brightness + direction * 5,
            0,
            255
        )

    elif settings_selected_item == SETTINGS_MAIN_OLED_BRIGHTNESS:
        main_oled_brightness = clamp(
            main_oled_brightness + direction * 5,
            0,
            255
        )

        apply_main_oled_brightness()

    elif settings_selected_item == SETTINGS_AUX_OLED_BRIGHTNESS:
        aux_oled_brightness = clamp(
            aux_oled_brightness + direction * 5,
            0,
            255
        )

        apply_aux_oled_brightness()

    elif settings_selected_item == SETTINGS_FAN_LOW:
        fan_low_percent = clamp(
            fan_low_percent + direction * 5,
            0,
            100
        )

    elif settings_selected_item == SETTINGS_FAN_MEDIUM:
        fan_medium_percent = clamp(
            fan_medium_percent + direction * 5,
            0,
            100
        )

    elif settings_selected_item == SETTINGS_FAN_MANUAL:
        fan_manual_percent = clamp(
            fan_manual_percent + direction * 5,
            0,
            100
        )

    elif settings_selected_item == SETTINGS_FAN_START:
        fan_auto_start_c = clamp(
            fan_auto_start_c + direction,
            10,
            70
        )

        if fan_auto_full_c <= fan_auto_start_c:
            fan_auto_full_c = (
                fan_auto_start_c + 1
            )

    elif settings_selected_item == SETTINGS_FAN_FULL:
        fan_auto_full_c = clamp(
            fan_auto_full_c + direction,
            fan_auto_start_c + 1,
            85
        )

    elif settings_selected_item == SETTINGS_FAN_RAMP_STEP:
        fan_ramp_step_percent = clamp(
            fan_ramp_step_percent + direction,
            1,
            20
        )

    elif settings_selected_item == SETTINGS_FAN_RAMP_TIME:
        fan_ramp_interval_ms = clamp(
            fan_ramp_interval_ms + direction * 25,
            25,
            1000
        )

    elif settings_selected_item == SETTINGS_METER_REFRESH:
        meter_refresh_ms = clamp(
            meter_refresh_ms + direction * 50,
            100,
            2000
        )

    elif settings_selected_item == SETTINGS_BOOT_SCREEN_TIME:
        boot_screen_ms = clamp(
            boot_screen_ms + direction * 250,
            0,
            10000
        )

    elif settings_selected_item == SETTINGS_POST_SCREEN_TIME:
        post_screen_ms = clamp(
            post_screen_ms + direction * 250,
            0,
            10000
        )

    elif settings_selected_item == SETTINGS_I2C_DEBUG:
        if direction != 0:
            i2c_debug_enabled = (
                not i2c_debug_enabled
            )

    mark_settings_unsaved()


def handle_settings_test_encoder(
    encoder_number,
    direction
):
    global test_selected_item

    # Encoder 6 scrolls test list too.
    if encoder_number == ENCODER_6:
        test_selected_item = wrap(
            test_selected_item + direction,
            TEST_RELAY_ALL_ON,
            TEST_RETURN_CONFIG
        )


def handle_settings_encoder(
    encoder_number,
    direction
):
    if settings_view == SETTINGS_VIEW_CONFIG:
        handle_settings_config_encoder(
            encoder_number,
            direction
        )
    else:
        handle_settings_test_encoder(
            encoder_number,
            direction
        )


def handle_encoder(
    encoder_number,
    direction
):
    global menu_selected_page

    if direction == 0:
        return

    # Main menu is entirely Encoder 6.
    if menu_browser_active:
        if encoder_number == ENCODER_6:
            menu_selected_page = wrap(
                menu_selected_page + direction,
                0,
                NUMBER_OF_PAGES - 1
            )
        return

    if active_page == PAGE_DECADE_BOX:
        handle_decade_encoder(
            encoder_number,
            direction
        )

    elif active_page == PAGE_METERS:
        handle_meter_encoder(
            encoder_number,
            direction
        )

    elif active_page == PAGE_LIGHTING:
        handle_lighting_encoder(
            encoder_number,
            direction
        )

    elif active_page == PAGE_CLIMATE:
        handle_climate_encoder(
            encoder_number,
            direction
        )

    elif active_page == PAGE_ACTUATOR:
        handle_actuator_encoder(
            encoder_number,
            direction
        )

    elif active_page == PAGE_SENSORS:
        handle_sensor_encoder(
            encoder_number,
            direction
        )

    elif active_page == PAGE_SETTINGS:
        handle_settings_encoder(
            encoder_number,
            direction
        )



            TEST_ITEM_NAMES[
                test_selected_item
            ][:16],
            0,
            22
        )

        if relay_test_active:
            display.text(
                "RELAYS ACTIVE",
                0,
                52
            )


def update_main_display(force=False):
    global display_retry_needed
    global main_cache_valid

    try:
        display.fill(0)

        if menu_browser_active:
            draw_menu_browser()

        elif active_page == PAGE_DECADE_BOX:
            draw_decade_box_page()

        elif active_page == PAGE_METERS:
            draw_meters_page()

        elif active_page == PAGE_LIGHTING:
            draw_lighting_page()

        elif active_page == PAGE_CLIMATE:
            draw_climate_page()

        elif active_page == PAGE_ACTUATOR:
            draw_actuator_page()

        elif active_page == PAGE_SENSORS:
            draw_sensors_page()

        elif active_page == PAGE_SETTINGS:
            draw_settings_page()

        picture = getattr(display, "buffer", None)

        # Skip the slow transfer if the picture is unchanged.
        if (
            picture is not None and
            main_cache_valid and
            not force and
            picture == last_main_buffer
        ):
            return

        display.show()

        if picture is not None:
            last_main_buffer[:] = picture
            main_cache_valid = True

    except OSError as error:
        main_cache_valid = False
        display_retry_needed = True
        report_display_error("MAIN OLED", error)
        
        
# ==================================================
# TCA9548A / SMALL OLED SETUP
# ==================================================

def tca_select_channel(channel_number):
    if channel_number < 0 or channel_number > 7:
        return False

    try:
        i2c_aux.writeto(
            TCA9548A_ADDRESS,
            bytes([1 << channel_number])
        )

        return True

    except OSError as error:
        if i2c_debug_enabled:
            print(
                "TCA select error:",
                channel_number,
                error
            )

        return False


def tca_disable_all_channels():
    try:
        i2c_aux.writeto(
            TCA9548A_ADDRESS,
            bytes([0x00])
        )

    except OSError:
        pass


# One persistent display object per TCA channel.
# This prevents repeated initialization lag.
small_displays = [
    None,
    None,
    None,
    None,
    None,
    None
]


def initialize_small_displays():
    if not ENABLE_ENCODER_DISPLAYS:
        return

    for channel_number in range(NUMBER_OF_ENCODERS):
        if not tca_select_channel(channel_number):
            continue

        try:
            small_displays[channel_number] = (
                SSD1306_I2C(
                    SMALL_DISPLAY_WIDTH,
                    SMALL_DISPLAY_HEIGHT,
                    i2c_aux,
                    addr=SMALL_OLED_ADDRESS
                )
            )

            set_oled_brightness(
                small_displays[channel_number],
                aux_oled_brightness
            )

        except OSError as error:
            small_displays[channel_number] = None

            if i2c_debug_enabled:
                print(
                    "Small OLED init error:",
                    channel_number,
                    error
                )

    tca_disable_all_channels()


# ==================================================

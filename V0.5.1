        if button_number == ENCODER_6:
            enter_selected_page()

        elif button_number == ENCODER_5:
            close_menu_browser()

        return

    # ACTIVE PAGE:
    #
    # Encoder 6 opens menu browser from all active pages.
    if button_number == ENCODER_6:
        open_menu_browser()
        return

    # ------------------------------------------------
    # DECADE BOX BUTTONS
    # ------------------------------------------------
    if active_page == PAGE_DECADE_BOX:
        # Encoder 1 button = toggle 1 MOhm stage.
        if button_number == ENCODER_1:
            extra_one_meg_enabled = (
                not extra_one_meg_enabled
            )

            relay_update_pending = True
            last_value_change_time = utime.ticks_ms()

        # Encoder 5 button = quick access to Live Meters.
        elif button_number == ENCODER_5:
            active_page = PAGE_METERS

        # Optional future dedicated meter button:
        #
        # If you later prefer Encoder 2 pushbutton instead
        # of Encoder 5 for the Decade Box -> Live Meters
        # shortcut, uncomment the next three lines:
        #
        # elif button_number == ENCODER_2:
        #     active_page = PAGE_METERS
        #     return

    # ------------------------------------------------
    # LIVE METERS BUTTONS
    # ------------------------------------------------
    elif active_page == PAGE_METERS:
        # Encoder 2 selects Current / Voltage / Power.
        if button_number == ENCODER_2:
            meter_view = wrap(
                meter_view + 1,
                METER_VIEW_CURRENT,
                METER_VIEW_POWER
            )

        # Encoder 5 returns directly to Decade Box.
        elif button_number == ENCODER_5:
            active_page = PAGE_DECADE_BOX

    # ------------------------------------------------
    # LIGHTING BUTTONS
    # ------------------------------------------------
    elif active_page == PAGE_LIGHTING:
        # Encoder 4 button changes custom White channel.
        if button_number == ENCODER_4:
            custom_white += 25

            if custom_white > 255:
                custom_white = 0

            mark_settings_unsaved()
            apply_lighting_mode()

    # ------------------------------------------------
    # CLIMATE BUTTONS
    # ------------------------------------------------
    elif active_page == PAGE_CLIMATE:
        # Encoder 1 button cycles fan mode.
        if button_number == ENCODER_1:
            global fan_mode

            fan_mode = wrap(
                fan_mode + 1,
                FAN_OFF,
                FAN_MANUAL
            )

    # ------------------------------------------------
    # SETTINGS BUTTONS
    # ------------------------------------------------
    elif active_page == PAGE_SETTINGS:
        if settings_view == SETTINGS_VIEW_CONFIG:
            # Encoder 2 button always saves settings,
            # including when Relay Delay is selected.
            if button_number == ENCODER_2:
                save_runtime_settings()

            # Encoder 4 button opens Test submenu only
            # while OPEN TESTS is selected.
            elif (
                button_number == ENCODER_4 and
                settings_selected_item == SETTINGS_OPEN_TESTS
            ):
                settings_view = SETTINGS_VIEW_TESTS

        else:
            # Test submenu:
            # Encoder 2 button runs selected test.
            if button_number == ENCODER_2:
                run_selected_test()

            # Encoder 4 returns to config submenu.
            elif button_number == ENCODER_4:
                settings_view = SETTINGS_VIEW_CONFIG


def handle_long_button_press(button_number):
    # Only on Decade Box page:
    # Hold Encoder 3 button to zero all digits.
    if (
        not menu_browser_active and
        active_page == PAGE_DECADE_BOX and
        button_number == ENCODER_3
    ):
        clear_all_decade_digits()


def read_buttons():
    action_occurred = False
    now = utime.ticks_ms()

    for button_number in range(NUMBER_OF_ENCODERS):
        pressed_now = (
            sw_pins[button_number].value() == 0
        )

        # New button press, with basic debounce guard.
        if (
            pressed_now and
            not button_was_pressed[button_number]
        ):
            elapsed = utime.ticks_diff(
                now,
                button_last_transition_time[
                    button_number
                ]
            )

            if elapsed >= BUTTON_DEBOUNCE_MS:
                button_was_pressed[
                    button_number
                ] = True

                button_press_time[
                    button_number
                ] = now

                button_long_press_done[
                    button_number
                ] = False

                button_last_transition_time[
                    button_number
                ] = now

        # Long press handling.
        if (
            pressed_now and
            button_was_pressed[button_number]
        ):
            held_time = utime.ticks_diff(
                now,
                button_press_time[button_number]
            )

            if (
                held_time >= ZERO_ALL_HOLD_MS and
                not button_long_press_done[
                    button_number
                ]
            ):
                button_long_press_done[
                    button_number
                ] = True

                handle_long_button_press(
                    button_number
                )

                action_occurred = True

        # Released button.
        if (
            not pressed_now and
            button_was_pressed[button_number]
        ):
            elapsed = utime.ticks_diff(
                now,
                button_last_transition_time[
                    button_number
                ]
            )

            if elapsed >= BUTTON_DEBOUNCE_MS:
                if not button_long_press_done[
                    button_number
                ]:
                    handle_short_button_press(
                        button_number
                    )

                    action_occurred = True

                button_was_pressed[
                    button_number
                ] = False

                button_long_press_done[
                    button_number
                ] = False

                button_last_transition_time[
                    button_number
                ] = now

    return action_occurred


# ==================================================
# SAFE BOOT HANDLER
# ==================================================

def run_safe_boot_screen():
    display.fill(0)

    display.text("SAFE MODE", 24, 12)
    display.text("MAIN LOOP OFF", 8, 28)
    display.text("CONNECT TO PC", 8, 44)

    display.show()

    print("SAFE MODE ACTIVE")
    print("Release GP15 and reset to run program")

    while True:
        utime.sleep_ms(100)


# ==================================================
# BOOT AND POST
# ==================================================

def startup_sequence():
    draw_boot_screen()
    utime.sleep_ms(boot_screen_ms)

    post_result = run_hardware_post()

    draw_post_screen(
        post_result[0],
        post_result[1],
        post_result[2],
        post_result[3],
        post_result[4]
    )

    utime.sleep_ms(post_screen_ms)


# ==================================================
# STARTUP
# ==================================================

# Ensure normal Ctrl-C keyboard interrupt remains enabled.
micropython.kbd_intr(3)

if safe_boot_requested:
    run_safe_boot_screen()

startup_sequence()

# Apply initial relay pattern.
update_relays()

# Read initial door state.
update_sensor_inputs()

# Draw all displays once.
update_main_display()
update_small_displays()

print("Lab panel started")
print("Resistance:", resistance_string(), "Ohm")


# ==================================================
# BACKGROUND SERVICE TIMERS
# ==================================================

last_meter_update_time = utime.ticks_ms()
last_temperature_update_time = utime.ticks_ms()
last_sensor_update_time = utime.ticks_ms()
last_main_display_refresh_time = utime.ticks_ms()


# ==================================================
# MAIN LOOP
#
# Ctrl-C will raise KeyboardInterrupt and return to the
# REPL because it is intentionally not caught here.
# ==================================================

while True:
    ui_changed = False

    # Read rotary encoders as quickly as possible.
    for encoder_number in range(NUMBER_OF_ENCODERS):
        direction = read_encoder_direction(
            encoder_number
        )

        if direction != 0:
            handle_encoder(
                encoder_number,
                direction
            )

            ui_changed = True

    # Read encoder buttons.
    if read_buttons():
        ui_changed = True

    # Redraw ALL screens only after actual UI interaction.
    # This avoids small OLED flashing.
    if ui_changed:
        update_main_display()
        update_small_displays()

        if (
            active_page == PAGE_DECADE_BOX and
            not menu_browser_active
        ):
            print(
                "Resistance:",
                resistance_string(),
                "Ohm"
            )

    # Delayed relay update to avoid chatter.
    service_delayed_relay_update()

    now = utime.ticks_ms()

    # Meter update. Does not redraw small screens.
    if utime.ticks_diff(
        now,
        last_meter_update_time
    ) >= meter_refresh_ms:
        last_meter_update_time = now
        update_measurements()

    # Temperature/fan update. Does not redraw small screens.
    if utime.ticks_diff(
        now,
        last_temperature_update_time
    ) >= 250:
        last_temperature_update_time = now

        update_temperature()
        service_fan_ramp()

    # Door/tool sensor update. Does not redraw small screens.
    if utime.ticks_diff(
        now,
        last_sensor_update_time
    ) >= 100:
        last_sensor_update_time = now

        update_sensor_inputs()

        if lighting_mode == LIGHT_TOOL_DETECT:
            apply_lighting_mode()

    # Main screen only can refresh live page values.
    # This keeps auxiliary OLEDs stable and non-flashing.
    if utime.ticks_diff(
        now,
        last_main_display_refresh_time
    ) >= 250:
        last_main_display_refresh_time = now

        if (
            not menu_browser_active and
            (
                active_page == PAGE_METERS or
                active_page == PAGE_CLIMATE or
                active_page == PAGE_SENSORS
            )
        ):
            update_main_display()

    # One millisecond sleep preserves responsive encoder reads.
    utime.sleep_ms(1)

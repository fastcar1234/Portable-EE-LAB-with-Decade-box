# ==================================================
# GENERAL HELPER FUNCTIONS
# ==================================================

def clamp(value, minimum, maximum):
    if value < minimum:
        return minimum

    if value > maximum:
        return maximum

    return value


def wrap(value, minimum, maximum):
    if value > maximum:
        return minimum

    if value < minimum:
        return maximum

    return value


def percent_to_duty_u16(percent):
    percent = clamp(percent, 0, 100)
    return (percent * 65535) // 100


def text_center_x(text, scale=1):
    return (
        DISPLAY_WIDTH -
        len(text) * 8 * scale
    ) // 2


def small_text_center_x(text):
    return (
        SMALL_DISPLAY_WIDTH -
        len(text) * 8
    ) // 2


def short_text(text, maximum=16):
    return text[:maximum]



def handle_short_button_press(button_number):
    global extra_one_meg_enabled
    global relay_update_pending
    global last_value_change_time
    global meter_view
    global custom_white
    global active_page
    global settings_view
    global fan_mode

    # MENU BROWSER:
    # Encoder 6 = enter.
    # Encoder 5 = cancel/back.
    if menu_browser_active:
        if button_number == ENCODER_6:
            enter_selected_page()

        elif button_number == ENCODER_5:
            close_menu_browser()

        return

    # Encoder 6 opens global menu on active pages,
    # except Settings where its rotation is used to
    # select an item but its button still opens Menu.
    if button_number == ENCODER_6:
        open_menu_browser()
        return

    # ------------------------------------------------
    # DECADE BOX BUTTONS
    # ------------------------------------------------
    if active_page == PAGE_DECADE_BOX:
        if button_number == ENCODER_1:
            extra_one_meg_enabled = (
                not extra_one_meg_enabled
            )

            relay_update_pending = True
            last_value_change_time = utime.ticks_ms()

        # Encoder 5 button: direct meter shortcut.
        elif button_number == ENCODER_5:
            active_page = PAGE_METERS

        # Optional alternate shortcut requested earlier:
        # uncomment later if Encoder 2 button should also
        # open the meter from Decade Box.
        #
        # elif button_number == ENCODER_2:
        #     active_page = PAGE_METERS

    # ------------------------------------------------
    # LIVE METERS BUTTONS
    # ------------------------------------------------
    elif active_page == PAGE_METERS:
        if button_number == ENCODER_2:
            meter_view = wrap(
                meter_view + 1,
                METER_VIEW_CURRENT,
                METER_VIEW_POWER
            )

        elif button_number == ENCODER_5:
            active_page = PAGE_DECADE_BOX

    # ------------------------------------------------
    # LIGHTING BUTTONS
    # ------------------------------------------------
    elif active_page == PAGE_LIGHTING:
        # Encoder 4 button cycles custom White channel.
        if button_number == ENCODER_4:
            custom_white += 25

            if custom_white > 255:
                custom_white = 0

            mark_settings_unsaved()
            apply_lighting_mode()

    # ------------------------------------------------
    # CLIMATE BUTTONS
    # ------------------------------------------------
    elif active_page == PAGE_CLIMATE:
        if button_number == ENCODER_1:
            fan_mode = wrap(
                fan_mode + 1,
                FAN_OFF,
                FAN_MANUAL
            )

    # ------------------------------------------------
    # SETTINGS BUTTONS
    # ------------------------------------------------
    elif active_page == PAGE_SETTINGS:
        if settings_view == SETTINGS_VIEW_CONFIG:
            # Encoder 2 button always saves, including
            # when Relay Delay is currently selected.
            if button_number == ENCODER_2:
                save_runtime_settings()

            # Only relevant if OPEN TESTS is selected.
            elif (
                button_number == ENCODER_4 and
                settings_selected_item == SETTINGS_OPEN_TESTS
            ):
                settings_view = SETTINGS_VIEW_TESTS

        else:
            # Test submenu:
            # Encoder 2 button runs / stops a test.
            if button_number == ENCODER_2:
                run_selected_test()

            # Button 4 is a direct return to configuration.
            elif button_number == ENCODER_4:
                settings_view = SETTINGS_VIEW_CONFIG


def handle_long_button_press(button_number):
    if (
        not menu_browser_active and
        active_page == PAGE_DECADE_BOX and
        button_number == ENCODER_3
    ):
        clear_all_decade_digits()


def read_buttons():
    action_occurred = False
    now = utime.ticks_ms()

    for button_number in range(NUMBER_OF_ENCODERS):
        pressed_now = (
            sw_pins[button_number].value() == 0
        )

        # New press.
        if (
            pressed_now and
            not button_was_pressed[button_number]
        ):
            elapsed = utime.ticks_diff(
                now,
                button_last_transition_time[
                    button_number
                ]
            )

            if elapsed >= BUTTON_DEBOUNCE_MS:
                button_was_pressed[
                    button_number
                ] = True

                button_press_time[
                    button_number
                ] = now

                button_long_press_done[
                    button_number
                ] = False

                button_last_transition_time[
                    button_number
                ] = now

        # Held press.
        if (
            pressed_now and
            button_was_pressed[button_number]
        ):
            held_time = utime.ticks_diff(
                now,
                button_press_time[button_number]
            )

            if (
                held_time >= ZERO_ALL_HOLD_MS and
                not button_long_press_done[
                    button_number
                ]
            ):
                button_long_press_done[
                    button_number
                ] = True

                handle_long_button_press(
                    button_number
                )

                action_occurred = True

        # Release.
        if (
            not pressed_now and
            button_was_pressed[button_number]
        ):
            elapsed = utime.ticks_diff(
                now,
                button_last_transition_time[
                    button_number
                ]
            )

            if elapsed >= BUTTON_DEBOUNCE_MS:
                if not button_long_press_done[
                    button_number
                ]:
                    handle_short_button_press(
                        button_number
                    )

                    action_occurred = True

                button_was_pressed[
                    button_number
                ] = False

                button_long_press_done[
                    button_number
                ] = False

                button_last_transition_time[
                    button_number
                ] = now

    return action_occurred


# ==================================================
# SAFE BOOT SCREEN
# ==================================================

def run_safe_boot_screen():
    display.fill(0)

    display.text("SAFE MODE", 28, 10)
    display.text("MAIN LOOP OFF", 12, 27)
    display.text("PC ACCESS READY", 4, 44)

    display.show()

    print("SAFE MODE ACTIVE")
    print("Edit/delete main.py as needed")
    print("Release GP15 and reset to run normally")

    while True:
        utime.sleep_ms(100)


# ==================================================
# STARTUP SEQUENCE
# ==================================================

def startup_sequence():
    draw_boot_screen()
    utime.sleep_ms(boot_screen_ms)

    post = run_hardware_post()

    draw_post_screen(
        post[0],
        post[1],
        post[2],
        post[3]
    )

    utime.sleep_ms(post_screen_ms)


# ==================================================
# STARTUP
# ==================================================

# Explicitly leave Ctrl-C interrupt enabled.
micropython.kbd_intr(3)

if safe_boot_requested:
    run_safe_boot_screen()

startup_sequence()

apply_main_oled_brightness()

initialize_small_displays()
apply_aux_oled_brightness()

update_relays()

update_sensor_inputs()

update_main_display()
update_small_displays()

print("Lab panel started")
print("Resistance:", resistance_string(), "Ohm")


# ==================================================
# BACKGROUND SERVICE TIMERS
# ==================================================

last_meter_update_time = utime.ticks_ms()
last_temperature_update_time = utime.ticks_ms()
last_sensor_update_time = utime.ticks_ms()
last_main_display_refresh_time = utime.ticks_ms()


# ==================================================
# MAIN LOOP
#
# Press Ctrl-C in Thonny to stop this loop.
# ==================================================

while True:
    ui_changed = False

    # Encoder scan occurs first and contains no display
    # I2C operations. This keeps response fast.
    for encoder_number in range(NUMBER_OF_ENCODERS):
        direction = read_encoder_direction(
            encoder_number
        )

        if direction != 0:
            handle_encoder(
                encoder_number,
                direction
            )

            ui_changed = True

    # Button scan follows encoder scan.
    if read_buttons():
        ui_changed = True

    # OLED updates only after user interface changes.
    if ui_changed:
        update_main_display()
        update_small_displays()

    # Non-blocking delayed relay update.
    service_delayed_relay_update()

    now = utime.ticks_ms()

    # Meter task.
    if utime.ticks_diff(
        now,
        last_meter_update_time
    ) >= meter_refresh_ms:
        last_meter_update_time = now
        update_measurements()

    # Temperature and fan task.
    if utime.ticks_diff(
        now,
        last_temperature_update_time
    ) >= 250:
        last_temperature_update_time = now

        update_temperature()
        service_fan_ramp()

    # Door / tool sensors.
    if utime.ticks_diff(
        now,
        last_sensor_update_time
    ) >= 100:
        last_sensor_update_time = now

        update_sensor_inputs()

    # Only the main OLED is refreshed for live pages.
    # Small OLEDs do NOT update here, preventing flashing.
    if utime.ticks_diff(
        now,
        last_main_display_refresh_time
    ) >= 250:
        last_main_display_refresh_time = now

        if (
            not menu_browser_active and
            (
                active_page == PAGE_METERS or
                active_page == PAGE_CLIMATE or
                active_page == PAGE_SENSORS
            )
        ):
            update_main_display()

    utime.sleep_ms(1)

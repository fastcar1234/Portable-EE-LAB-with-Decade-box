# ==================================================

def handle_decade_encoder(
    encoder_number,
    direction
):
    global relay_update_pending
    global last_value_change_time

    digits[encoder_number] += direction

    if digits[encoder_number] > 9:
        digits[encoder_number] = 0

    if digits[encoder_number] < 0:
        digits[encoder_number] = 9

    relay_update_pending = True
    last_value_change_time = utime.ticks_ms()



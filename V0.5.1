# ==================================================
# LARGE TEXT FUNCTIONS
# ==================================================

def big_text(display_object, text, x, y, scale):
    width = len(text) * 8
    height = 8

    buffer = bytearray(width * height)

    text_buffer = framebuf.FrameBuffer(
        buffer,
        width,
        height,
        framebuf.MONO_VLSB
    )

    text_buffer.text(text, 0, 0, 1)

    for pixel_x in range(width):
        for pixel_y in range(height):
            if text_buffer.pixel(pixel_x, pixel_y):
                display_object.fill_rect(
                    x + pixel_x * scale,
                    y + pixel_y * scale,
                    scale,
                    scale,
                    1
                )


def big_text_stretched(
    display_object,
    text,
    x,
    y,
    scale_x,
    scale_y
):
    width = len(text) * 8
    height = 8

    buffer = bytearray(width * height)

    text_buffer = framebuf.FrameBuffer(
        buffer,
        width,
        height,
        framebuf.MONO_VLSB
    )

    text_buffer.text(text, 0, 0, 1)

    for pixel_x in range(width):
        for pixel_y in range(height):
            if text_buffer.pixel(pixel_x, pixel_y):
                display_object.fill_rect(
                    x + pixel_x * scale_x,
                    y + pixel_y * scale_y,
                    scale_x,
                    scale_y,
                    1
                )


def draw_omega(x, y, scale):
    omega_bitmap = (
        "0011111100",
        "0110000110",
        "1100000011",
        "1100000011",
        "1100000011",
        "1100000011",
        "1100000011",
        "1100000011",
        "0110000110",
        "0011111100",
        "0010010100",
        "1100010011"
    )

    for row in range(12):
        for column in range(10):
            if omega_bitmap[row][column] == "1":
                display.fill_rect(
                    x + column * scale,
                    y + row * scale,
                    scale,
                    scale,
                    1
                )


# ==================================================
# VALUE FORMATTERS
# ==================================================

def resistance_value():
    return (
        digits[0] * 100000 +
        digits[1] * 10000 +
        digits[2] * 1000 +
        digits[3] * 100 +
        digits[4] * 10 +
        digits[5]
    )


def total_resistance_value():
    result = resistance_value()

    if extra_one_meg_enabled:
        result += 1000000

    return result


def resistance_string():
    return "{:,}".format(
        total_resistance_value()
    )


def current_string(current_amps):
    current_abs = abs(current_amps)

    if current_abs < 0.001:
        return "{:.1f}uA".format(
            current_amps * 1000000
        )

    if current_abs < 1.0:
        return "{:.1f}mA".format(
            current_amps * 1000
        )

    return "{:.3f}A".format(current_amps)


def voltage_string(voltage_volts):
    return "{:.3f}V".format(
        voltage_volts
    )


def power_string(power_watts):
    if abs(power_watts) < 1.0:
        return "{:.1f}mW".format(
            power_watts * 1000
        )

    return "{:.3f}W".format(
        power_watts
    )


# ==================================================
# SSD1306 BRIGHTNESS CONTROL
#
# Contrast command = 0x81 followed by 0..255.
# ==================================================

def set_oled_brightness(oled, brightness):
    brightness = clamp(brightness, 0, 255)

    try:
        oled.write_cmd(0x81)
        oled.write_cmd(brightness)

    except Exception as error:
        if i2c_debug_enabled:
            print("OLED contrast error:", error)


def apply_main_oled_brightness():
    set_oled_brightness(
        display,
        main_oled_brightness
    )


def apply_aux_oled_brightness():
    if not ENABLE_ENCODER_DISPLAYS:
        return

    for channel_number in range(NUMBER_OF_ENCODERS):
        oled = small_displays[channel_number]

        if oled is None:
            continue

        if tca_select_channel(channel_number):
            set_oled_brightness(
                oled,
                aux_oled_brightness
            )

    tca_disable_all_channels()



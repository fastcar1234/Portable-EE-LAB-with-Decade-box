def big_text(display_object, text, x, y, scale):
    width = len(text) * 8
    height = 8

    buffer = bytearray(width * height)

    text_buffer = framebuf.FrameBuffer(
        buffer,
        width,
        height,
        framebuf.MONO_VLSB
    )

    text_buffer.text(text, 0, 0, 1)

    for pixel_x in range(width):
        for pixel_y in range(height):
            if text_buffer.pixel(pixel_x, pixel_y):
                display_object.fill_rect(
                    x + pixel_x * scale,
                    y + pixel_y * scale,
                    scale,
                    scale,
                    1
                )


def big_text_stretched(
    display_object,
    text,
    x,
    y,
    scale_x,
    scale_y
):
    width = len(text) * 8
    height = 8

    buffer = bytearray(width * height)

    text_buffer = framebuf.FrameBuffer(
        buffer,
        width,
        height,
        framebuf.MONO_VLSB
    )

    text_buffer.text(text, 0, 0, 1)

    for pixel_x in range(width):
        for pixel_y in range(height):
            if text_buffer.pixel(pixel_x, pixel_y):
                display_object.fill_rect(
                    x + pixel_x * scale_x,
                    y + pixel_y * scale_y,
                    scale_x,
                    scale_y,
                    1
                )


def draw_omega(x, y, scale):
    omega_bitmap = (
        "0011111100",
        "0110000110",
        "1100000011",
        "1100000011",
        "1100000011",
        "1100000011",
        "1100000011",
        "1100000011",
        "0110000110",
        "0011111100",
        "0010010100",
        "1100010011"
    )

    for row in range(12):
        for column in range(10):
            if omega_bitmap[row][column] == "1":
                display.fill_rect(
                    x + column * scale,
                    y + row * scale,
                    scale,
                    scale,
                    1
                )


# ==================================================
# VALUE FORMATTERS
# ==================================================

def resistance_value():
    return (
        digits[0] * 100000 +
        digits[1] * 10000 +
        digits[2] * 1000 +
        digits[3] * 100 +
        digits[4] * 10 +
        digits[5]
    )


def total_resistance_value():
    result = resistance_value()

    if extra_one_meg_enabled:
        result += 1000000

    return result


def resistance_string():
    return "{:,}".format(
        total_resistance_value()
    )


def current_string(current_amps):
    absolute_current = abs(current_amps)

    if absolute_current < 0.001:
        return "{:.1f}uA".format(
            current_amps * 1000000
        )

    if absolute_current < 1.0:
        return "{:.1f}mA".format(
            current_amps * 1000
        )

    return "{:.3f}A".format(current_amps)


def voltage_string(voltage_volts):
    return "{:.3f}V".format(
        voltage_volts
    )


def power_string(power_watts):
    if abs(power_watts) < 1.0:
        return "{:.1f}mW".format(
            power_watts * 1000
        )

    return "{:.3f}W".format(
        power_watts
    )



# ==================================================
# MISSING DEVICE REPORT
# ==================================================

def report_missing_devices():
    missing = []

    if not main_oled_ok:
        missing.append("MAIN OLED 0x{:02X}".format(MAIN_OLED_ADDRESS))

    if ENABLE_MCP_1 and MCP_1_ADDRESS not in main_scan_result:
        missing.append("MCP #1 0x{:02X}".format(MCP_1_ADDRESS))

    if ENABLE_MCP_2 and MCP_2_ADDRESS not in main_scan_result:
        missing.append("MCP #2 0x{:02X}".format(MCP_2_ADDRESS))

    if ENABLE_MCP_3 and MCP_3_ADDRESS not in main_scan_result:
        missing.append("MCP #3 0x{:02X}".format(MCP_3_ADDRESS))
   
  if (
        ENABLE_CURRENT_VOLTAGE_METER and
        INA238_ADDRESS not in aux_scan_result
    ):
        missing.append("INA238 0x{:02X}".format(INA238_ADDRESS))
        
    if TCA9548A_ADDRESS not in aux_scan_result:
        missing.append("TCA9548A 0x{:02X}".format(TCA9548A_ADDRESS))
    else:
        for channel_number in range(NUMBER_OF_ENCODERS):
            if small_displays[channel_number] is None:
                missing.append("SMALL OLED " + str(channel_number + 1))

    if len(missing) == 0:
        print("All expected devices found")
        return

    print("MISSING DEVICES:")
    for name in missing:
        print("  -", name)

    if not main_oled_ok:
        return  # no screen to show it on

    display.fill(0)
    display.text("MISSING DEVICE", 8, 0)
    display.hline(0, 10, DISPLAY_WIDTH, 1)

    max_lines = 5
    if len(missing) > max_lines:
        shown = missing[:max_lines - 1]
        shown.append("+" + str(len(missing) - (max_lines - 1)) + " MORE")
    else:
        shown = missing

    y_position = 14
    for name in shown:
        display.text(name[:16], 0, y_position)
        y_position += 10

    display.show()

    hold_time = post_screen_ms
    if hold_time < 3000:
        hold_time = 3000
    utime.sleep_ms(hold_time)
# ==================================================
# I2C SCAN, SCAN SCREEN, AND PERIODIC RE-SCAN
# ==================================================

# Addresses from the project brief.
EXPECTED_I2C0 = (0x20, 0x24, 0x26, 0x3C, 0x40, 0x4C, 0x70)
EXPECTED_I2C1 = (0x40, 0x4C, 0x68, 0x70)

RESCAN_INTERVAL_MS = 5000


def hex_list(addresses):
    return " ".join("{:02X}".format(a) for a in addresses)


def scan_bus(bus, bus_name, disable_mux=False):
    # Returns a list of addresses, or None if the scan failed.
    if disable_mux:
        # Make sure no mux channel is open, so the small
        # OLEDs do not show up on the I2C1 scan.
        try:
            bus.writeto(TCA9548A_ADDRESS, bytes([0x00]))
        except OSError:
            pass

    try:
        return bus.scan()
    except OSError as error:
        print("Scan failed on", bus_name, error)
        return None


def print_bus_report(bus_name, found, expected):
    not_found = [a for a in expected if a not in found]
    unexpected = [a for a in found if a not in expected]

    print(bus_name, "found (hex):", hex_list(found) or "none")
    print(bus_name, "found (dec):", found)
    print(bus_name, "not found:  ", hex_list(not_found) or "none")
    print(bus_name, "unexpected: ", hex_list(unexpected) or "none")


def print_scan_report():
    print("---- I2C SCAN REPORT ----")
    print_bus_report("I2C0", main_scan_result, EXPECTED_I2C0)
    print_bus_report("I2C1", aux_scan_result, EXPECTED_I2C1)
    print("-------------------------")


def report_changes(bus_name, old_list, new_list):
    for address in new_list:
        if address not in old_list:
            print(bus_name, "device appeared: 0x{:02X}".format(address))

    for address in old_list:
        if address not in new_list:
            print(bus_name, "device disappeared: 0x{:02X}".format(address))


def draw_scan_bus(name, found, y, max_rows):
    display.text(
        name + " " + str(len(found)) + " FOUND",
        0,
        y
    )

    per_row = 5

    for row in range(max_rows):
        chunk = found[row * per_row:(row + 1) * per_row]

        if len(chunk) == 0:
            break

        line = hex_list(chunk)

        # Not enough room for everything: end with "..".
        if (
            row == max_rows - 1 and
            len(found) > (row + 1) * per_row
        ):
            line = hex_list(chunk[:4]) + " .."

        display.text(line, 0, y + 10 + row * 10)


def draw_scan_screen():
    display.fill(0)
    display.text("I2C SCAN", 0, 0)
    display.hline(0, 10, DISPLAY_WIDTH, 1)

    draw_scan_bus("I2C0", main_scan_result, 14, 2)
    draw_scan_bus("I2C1", aux_scan_result, 46, 1)

    display.show()


def rescan_i2c_buses():
    # Scans both buses, prints any changes, and restores
    # a main OLED or mux that has come back.
    global main_scan_result
    global aux_scan_result
    global main_oled_ok
    global display
    global display_retry_needed

    new_main = scan_bus(i2c_main, "I2C0", False)
    new_aux = scan_bus(i2c_aux, "I2C1", True)

    # A failed scan keeps the old result, so one bad
    # scan does not make every device look gone.
    if new_main is not None:
        old_main = main_scan_result
        report_changes("I2C0", old_main, new_main)
        main_scan_result = new_main

        # An enabled relay chip that has just appeared
        # gets its pins set up now.
        for address in (MCP_1_ADDRESS, MCP_2_ADDRESS):
            if address in new_main and address not in old_main:
                mcp_setup_relay_chip(address)

        if MAIN_OLED_ADDRESS not in new_main:
            main_oled_ok = False

        elif not main_oled_ok:
            try:
                display = SSD1306_I2C(
                    DISPLAY_WIDTH,
                    DISPLAY_HEIGHT,
                    i2c_main,
                    addr=MAIN_OLED_ADDRESS
                )

                main_oled_ok = True
                apply_main_oled_brightness()
                invalidate_display_cache()
                display_retry_needed = True
                print("Main OLED restored")

            except OSError as error:
                print("Main OLED restore failed:", error)

    # MCP23017 chips that appear late are only reported here.
    # Their setup is added with the relay rewrite (step 4).

    if new_aux is not None:
        tca_was_present = TCA9548A_ADDRESS in aux_scan_result

        report_changes("I2C1", aux_scan_result, new_aux)
        aux_scan_result = new_aux

        if (
            TCA9548A_ADDRESS in new_aux and
            not tca_was_present
        ):
            initialize_small_displays()
            apply_aux_oled_brightness()
            invalidate_display_cache()
            display_retry_needed = True
            print("Small OLEDs set up again")

    # Set up the meter if it has appeared, or after an error.
    if ENABLE_CURRENT_VOLTAGE_METER and not ina238_ready:
        if INA238_ADDRESS in aux_scan_result:
            ina238_setup()


def any_button_down():
    for pin in sw_pins:
        if pin.value() == 0:
            return True

    return False

# ==================================================
# INA238 CURRENT / VOLTAGE METER (I2C1, 0x40)
#
# Current is calculated from the shunt voltage:
#   current = shunt volts / 0.015 ohm
# ==================================================

INA238_ADDRESS = 0x40

INA238_REG_CONFIG = 0x00
INA238_REG_ADC_CONFIG = 0x01
INA238_REG_VSHUNT = 0x04
INA238_REG_VBUS = 0x05
INA238_REG_DIETEMP = 0x06
INA238_REG_MANUFACTURER = 0x3E
INA238_REG_DEVICE_ID = 0x3F

INA238_SHUNT_OHMS = 0.015

# CONFIG = 0x0010: ADCRANGE = 1 (+/-40.96 mV, 1.25 uV per step)
INA238_CONFIG_VALUE = 0x0010

# ADC_CONFIG = 0xFB6A: continuous mode, 1.052 ms conversions,
# average of 16 readings (about 50 ms per result).
INA238_ADC_CONFIG_VALUE = 0xFB6A

INA238_SHUNT_LSB_VOLTS = 1.25e-6
INA238_VBUS_LSB_VOLTS = 3.125e-3

# Change to -1.0 if current reads negative when it should
# be positive.
INA238_CURRENT_SIGN = 1.0

ina238_ready = False


def ina238_read_u16(register):
    data = i2c_aux.readfrom_mem(INA238_ADDRESS, register, 2)
    return (data[0] << 8) | data[1]


def ina238_to_signed(value):
    if value >= 32768:
        return value - 65536

    return value


def ina238_write_u16(register, value):
    i2c_aux.writeto_mem(
        INA238_ADDRESS,
        register,
        bytes([(value >> 8) & 0xFF, value & 0xFF])
    )


def ina238_setup():
    global ina238_ready

    ina238_ready = False

    if not ENABLE_CURRENT_VOLTAGE_METER:
        return False

    if INA238_ADDRESS not in aux_scan_result:
        return False

    try:
        manufacturer = ina238_read_u16(INA238_REG_MANUFACTURER)
        device = ina238_read_u16(INA238_REG_DEVICE_ID)

        if manufacturer != 0x5449 or (device >> 4) != 0x238:
            print(
                "INA238 check FAILED. Manufacturer 0x{:04X} (want 0x5449), "
                "device 0x{:03X} (want 0x238)".format(
                    manufacturer,
                    device >> 4
                )
            )
            return False

        # Reset, then apply our settings.
        ina238_write_u16(INA238_REG_CONFIG, 0x8000)
        utime.sleep_ms(5)
        ina238_write_u16(INA238_REG_CONFIG, INA238_CONFIG_VALUE)
        ina238_write_u16(INA238_REG_ADC_CONFIG, INA238_ADC_CONFIG_VALUE)

        # Wait for the first averaged result.
        utime.sleep_ms(60)

    except OSError as error:
        print("INA238 setup failed:", error)
        return False

    ina238_ready = True
    print("INA238 ready (ID 0x{:04X} / 0x{:03X})".format(
        manufacturer,
        device >> 4
    ))
    return True


def ina238_read_raw():
    # Returns (shunt_raw, vbus_raw), both signed 16-bit.
    shunt_raw = ina238_to_signed(ina238_read_u16(INA238_REG_VSHUNT))
    vbus_raw = ina238_to_signed(ina238_read_u16(INA238_REG_VBUS))
    return shunt_raw, vbus_raw


# ==================================================
# INA238 TEST SCREEN (bring-up tool, read-only)
# Press ENCODER 1 to exit.
# ==================================================

def run_ina238_test():
    while any_button_down():
        utime.sleep_ms(10)

    if not ina238_ready:
        ina238_setup()

    loop_count = 0

    while True:
        lines = []
        console_line = None

        if not ina238_ready:
            lines = ["NOT READY", "CHECK SWITCH", "AND I2C SCAN"]
        else:
            try:
                shunt_raw, vbus_raw = ina238_read_raw()
                temp_raw = ina238_to_signed(
                    ina238_read_u16(INA238_REG_DIETEMP)
                ) >> 4

                shunt_uv = shunt_raw * 1.25
                volts = vbus_raw * INA238_VBUS_LSB_VOLTS
                milliamps = (
                    shunt_raw * INA238_SHUNT_LSB_VOLTS *
                    INA238_CURRENT_SIGN / INA238_SHUNT_OHMS
                ) * 1000

                lines = [
                    "VBUS {:.3f}V".format(volts),
                    "SHUNT {:.1f}uV".format(shunt_uv),
                    "I {:.2f}mA".format(milliamps),
                    "RAW {} {}".format(shunt_raw, vbus_raw),
                    "DIE {:.1f}C".format(temp_raw * 0.125)
                ]

                console_line = (
                    "INA238 V={:.3f}  shunt={:.1f}uV  I={:.2f}mA  "
                    "raw={} {}".format(
                        volts, shunt_uv, milliamps, shunt_raw, vbus_raw
                    )
                )

            except OSError:
                lines = ["READ ERROR"]

        try:
            display.fill(0)
            display.text("INA238 ENC1 EXIT", 0, 0)

            y_position = 11
            for text in lines:
                display.text(text[:16], 0, y_position)
                y_position += 11

            display.show()

        except OSError as error:
            report_display_error("MAIN OLED", error)

        # Print to the console about once a second.
        if console_line is not None and loop_count % 4 == 0:
            print(console_line)

        loop_count += 1

        # Encoder 1 button: exit.
        if sw_pins[ENCODER_1].value() == 0:
            utime.sleep_ms(30)

            if sw_pins[ENCODER_1].value() == 0:
                break

        utime.sleep_ms(250)

    while any_button_down():
        utime.sleep_ms(10)

    utime.sleep_ms(50)
    invalidate_display_cache()

# ==================================================
# STARTUP SEQUENCE
# ==================================================

def startup_sequence():
    draw_boot_screen()
    utime.sleep_ms(boot_screen_ms)

    post = run_hardware_post()

    draw_post_screen(
        post[0],
        post[1],
        post[2],
        post[3]
    )

    utime.sleep_ms(post_screen_ms)


# ==================================================
# STARTUP
# ==================================================

# Explicitly leave Ctrl-C interrupt enabled.
micropython.kbd_intr(3)

if safe_boot_requested:
    run_safe_boot_screen()

startup_sequence()

apply_main_oled_brightness()

initialize_small_displays()
apply_aux_oled_brightness()
report_missing_devices()
initialize_small_displays()
apply_aux_oled_brightness()
report_missing_devices()
print_scan_report()
ina238_setup()

update_relays()

update_sensor_inputs()

update_main_display()
update_small_displays()

print("Lab panel started")
print("Resistance:", resistance_string(), "Ohm")


# ==================================================
# BACKGROUND SERVICE TIMERS
# ==================================================

last_meter_update_time = utime.ticks_ms()
last_temperature_update_time = utime.ticks_ms()
last_sensor_update_time = utime.ticks_ms()
last_main_display_refresh_time = utime.ticks_ms()
last_i2c_rescan_time = utime.ticks_ms()


# ==================================================
# MAIN LOOP
#
# Press Ctrl-C in Thonny to stop this loop.
# ==================================================

while True:
    ui_changed = False

    # Encoder scan occurs first and contains no display
    # I2C operations. This keeps response fast.
    for encoder_number in range(NUMBER_OF_ENCODERS):
        direction = read_encoder_direction(
            encoder_number
        )

        if direction != 0:
            handle_encoder(
                encoder_number,
                direction
            )

            ui_changed = True

    # Button scan follows encoder scan.
    if read_buttons():
        ui_changed = True

    # OLED updates only after user interface changes.
    if ui_changed:
        update_main_display(True)
        update_small_displays(True)

    # Non-blocking delayed relay update.
    service_delayed_relay_update()

    now = utime.ticks_ms()

    # Meter task.
    if utime.ticks_diff(
        now,
        last_meter_update_time
    ) >= meter_refresh_ms:
        last_meter_update_time = now
        update_measurements()

    # Temperature and fan task.
    if utime.ticks_diff(
        now,
        last_temperature_update_time
    ) >= 250:
        last_temperature_update_time = now

        update_temperature()
        service_fan_ramp()

    # Door / tool sensors.
    if utime.ticks_diff(
        now,
        last_sensor_update_time
    ) >= 100:
        last_sensor_update_time = now

        update_sensor_inputs()

    # Only the main OLED is refreshed for live pages.
    # Small OLEDs do NOT update here, preventing flashing.
    if utime.ticks_diff(
        now,
        last_main_display_refresh_time
    ) >= 250:
        last_main_display_refresh_time = now

        if (
            not menu_browser_active and
            (
                active_page == PAGE_METERS or
                active_page == PAGE_CLIMATE or
                active_page == PAGE_SENSORS
            )
        ):
             update_main_display()
    # Re-scan the I2C buses every few seconds.
    if utime.ticks_diff(
        now,
        last_i2c_rescan_time
    ) >= RESCAN_INTERVAL_MS:
        last_i2c_rescan_time = now
        rescan_i2c_buses() 
    # Retry screens that failed earlier.
    if (
        display_retry_needed and
        utime.ticks_diff(now, last_display_retry_time) >= 500
    ):
        last_display_retry_time = now
        display_retry_needed = False
        update_main_display()
        update_small_displays()

    utime.sleep_ms(1)

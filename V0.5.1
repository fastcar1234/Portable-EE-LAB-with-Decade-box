def apply_brightness(value):
    return (
        value * lighting_brightness
    ) // 255


def static_color_for_mode():
    if lighting_mode == LIGHT_TRUE_WHITE:
        return (0, 0, 0, 255)

    if lighting_mode == LIGHT_WARM_WHITE:
        return (255, 80, 0, 170)

    if lighting_mode == LIGHT_RED:
        return (255, 0, 0, 0)

    if lighting_mode == LIGHT_ORANGE:
        return (255, 70, 0, 0)

    if lighting_mode == LIGHT_YELLOW:
        return (255, 180, 0, 0)

    if lighting_mode == LIGHT_LIME:
        return (140, 255, 0, 0)

    if lighting_mode == LIGHT_GREEN:
        return (0, 255, 0, 0)

    if lighting_mode == LIGHT_MINT:
        return (0, 255, 120, 0)

    if lighting_mode == LIGHT_CYAN:
        return (0, 255, 255, 0)

    if lighting_mode == LIGHT_SKY_BLUE:
        return (0, 120, 255, 0)

    if lighting_mode == LIGHT_BLUE:
        return (0, 0, 255, 0)

    if lighting_mode == LIGHT_INDIGO:
        return (70, 0, 255, 0)

    if lighting_mode == LIGHT_VIOLET:
        return (150, 0, 255, 0)

    if lighting_mode == LIGHT_PURPLE:
        return (180, 0, 180, 0)

    if lighting_mode == LIGHT_MAGENTA:
        return (255, 0, 255, 0)

    if lighting_mode == LIGHT_PINK:
        return (255, 20, 120, 50)

    if lighting_mode == LIGHT_CUSTOM:
        return (
            custom_red,
            custom_green,
            custom_blue,
            custom_white
        )

    return (0, 0, 0, 0)


def write_logical_led_port(
    port_number,
    red,
    green,
    blue,
    white
):
    # Placeholder until the final 12-output LED hardware
    # arrangement has been selected.
    #
    # The logical port system already supports:
    # LED_PORT_COUNT = 1 through 12.
    #
    # Add actual PIO or external-controller writes later.
    if port_number < 0 or port_number >= 12:
        return

    if port_number >= LED_PORT_COUNT:
        return

    if not logical_led_port_enabled[port_number]:
        return

    strip = led_port_objects[port_number]

    if strip is None:
        return


def apply_lighting_mode():
    # Placeholder logical action only until strips exist.
    if lighting_mode == LIGHT_TOOL_DETECT:
        for port_number in range(LED_PORT_COUNT):
            tool_number = port_number % len(
                tool_sensor_states
            )

            if tool_sensor_states[tool_number]:
                write_logical_led_port(
                    port_number,
                    255,
                    70,
                    0,
                    0
                )

            else:
                write_logical_led_port(
                    port_number,
                    0,
                    0,
                    0,
                    100
                )

        return

    if lighting_mode == LIGHT_RAINBOW:
        for port_number in range(LED_PORT_COUNT):
            phase = (
                port_number * 255
            ) // max(1, LED_PORT_COUNT - 1)

            if phase < 85:
                red = 255 - phase * 3
                green = phase * 3
                blue = 0

            elif phase < 170:
                phase -= 85
                red = 0
                green = 255 - phase * 3
                blue = phase * 3

            else:
                phase -= 170
                red = phase * 3
                green = 0
                blue = 255 - phase * 3

            write_logical_led_port(
                port_number,
                red,
                green,
                blue,
                0
            )

        return

    red, green, blue, white = static_color_for_mode()

    for port_number in range(LED_PORT_COUNT):
        write_logical_led_port(
            port_number,
            red,
            green,
            blue,
            white
        )



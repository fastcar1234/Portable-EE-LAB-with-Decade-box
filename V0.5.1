def draw_small_oled(
    oled,
    top_line,
    middle_line,
    bottom_line,
    highlight_line
):
    # A 128x32 display has four 8-pixel text rows.
    # Three centered text rows use most of its physical
    # area while retaining clean spacing.
    oled.fill(0)

    lines = (
        (top_line, 0, 1),
        (middle_line, 11, 2),
        (bottom_line, 22, 3)
    )

    for text, y_position, line_number in lines:
        if text == "":
            continue

        shown_text = short_text(text)
        x_position = small_text_center_x(shown_text)

        if highlight_line == line_number:
            oled.fill_rect(
                0,
                y_position - 1,
                SMALL_DISPLAY_WIDTH,
                10,
                1
            )

            oled.text(
                shown_text,
                x_position,
                y_position,
                0
            )

        else:
            oled.text(
                shown_text,
                x_position,
                y_position,
                1
            )

    oled.show()


def update_small_displays():
    # Called only for a user-visible UI change.
    # Never call from fast background tasks.
    if not ENABLE_ENCODER_DISPLAYS:
        return

    display_data = small_display_content()

    for channel_number in range(NUMBER_OF_ENCODERS):
        oled = small_displays[channel_number]

        if oled is None:
            continue

        if not tca_select_channel(channel_number):
            continue

        top_line = display_data[channel_number][0]
        middle_line = display_data[channel_number][1]
        bottom_line = display_data[channel_number][2]
        highlighted = display_data[channel_number][3]

        draw_small_oled(
            oled,
            top_line,
            middle_line,
            bottom_line,
            highlighted
        )

    tca_disable_all_channels()


# ==================================================
# DECADE RELAY OUTPUTS
# ==================================================

def update_relays():
    if relay_test_active:
        return

    relay_bits = 0

    for decade in range(NUMBER_OF_ENCODERS):
        relay_bits |= (
            (digits[decade] & 0x0F) <<
            (decade * 4)
        )

    if extra_one_meg_enabled:
        relay_bits |= (1 << 24)

    # MCP #1 gets bits 0 through 15.
    mcp_write_16_outputs(
        MCP_1_ADDRESS,
        relay_bits & 0xFFFF
    )

    # MCP #2:
    # GPA0-GPA7 = bits 16-23.
    # GPB0 / GPB1 = available outputs.
    # GPB2 / GPB3 = door inputs.
    # GPB4 = +1M relay output.
    #
    # This keeps the two door inputs away from GPB0/GPB1
    # as requested, while placing 1M on GPB4.
    relay_word_2 = (
        (relay_bits >> 16) & 0x00FF
    )

    if extra_one_meg_enabled:
        relay_word_2 |= (1 << 12)

    mcp_write_16_outputs(
        MCP_2_ADDRESS,
        relay_word_2
    )


def relay_test_all_on():
    global relay_test_active

    relay_test_active = True

    # MCP #1: all outputs on.
    mcp_write_16_outputs(
        MCP_1_ADDRESS,
        0xFFFF
    )

    # MCP #2:
    # Port A all on.
    # GPB0 / GPB1 outputs on.
    # GPB2 / GPB3 are input pins, unaffected.
    # GPB4-GPB7 outputs on.
    mcp_write_16_outputs(
        MCP_2_ADDRESS,
        0xF3FF
    )

    print("Relay test active")


def relay_test_stop():
    global relay_test_active

    relay_test_active = False

    update_relays()

    print("Relay test stopped")


def service_delayed_relay_update():
    global relay_update_pending

    if not relay_update_pending:
        return

    elapsed = utime.ticks_diff(
        utime.ticks_ms(),
        last_value_change_time
    )

    if elapsed >= RELAY_SETTLE_DELAY_MS:
        update_relays()

        relay_update_pending = False



def load_settings():
    loaded_settings = {}

    for key in DEFAULT_SETTINGS:
        loaded_settings[key] = DEFAULT_SETTINGS[key]

    try:
        file_handle = open(
            SETTINGS_FILENAME,
            "r"
        )

        stored_settings = json.load(file_handle)
        file_handle.close()

        for key in DEFAULT_SETTINGS:
            if key in stored_settings:
                loaded_settings[key] = stored_settings[key]

        print("Settings file found and applied")
        return loaded_settings, True

    except Exception as error:
        print("No usable settings file:", error)
        return loaded_settings, False


def save_settings_file():
    global settings_unsaved
    global settings_message

    try:
        file_handle = open(
            SETTINGS_FILENAME,
            "w"
        )

        json.dump(settings, file_handle)
        file_handle.close()

        settings_unsaved = False
        settings_message = "SAVED"

        print("Settings saved successfully")

        # Re-open and parse the file to confirm that it
        # was actually written and is readable.
        verify_handle = open(
            SETTINGS_FILENAME,
            "r"
        )

        verify_data = json.load(verify_handle)
        verify_handle.close()

        if "relay_delay_ms" in verify_data:
            print("Settings save verified")
        else:
            settings_message = "SAVE VERIFY ERR"
            print("Settings verification failed")

    except Exception as error:
        settings_message = "SAVE ERROR"
        print("Settings save error:", error)


